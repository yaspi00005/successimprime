diff --git a/templates/fournisseurs/index.html.twig b/templates/fournisseurs/index.html.twig
new file mode 100644
index 0000000..2146f4e
--- /dev/null
+++ b/templates/fournisseurs/index.html.twig
@@ -0,0 +1,177 @@
+{% extends 'base.html.twig' %}
+
+{% block title %}
+	Fournisseurs
+{% endblock %}
+
+{% block body %}
+
+	{% include "alert.html.twig" %}
+
+	<div class="side-app">
+
+		<div class="page-header">
+
+			<div>
+
+				<h1 class="page-title">
+					Fournisseurs
+				</h1>
+
+				<ol class="breadcrumb">
+					<li class="breadcrumb-item">
+						Achats
+					</li>
+					<li class="breadcrumb-item active">
+						Fournisseurs
+					</li>
+				</ol>
+
+			</div>
+
+			<div class="ml-auto">
+
+				<a href="{{ path('app_fournisseur_new') }}" class="btn btn-primary-light">
+					<i class="fa fa-plus mr-1"></i>
+					Nouveau fournisseur
+				</a>
+
+			</div>
+
+		</div>
+
+
+		<div class="row row-cards">
+
+			<div class="col-lg-12">
+
+				<div class="card">
+
+					<div class="card-header">
+
+						<div>
+							<h3 class="card-title mb-1">
+								Liste des fournisseurs
+							</h3>
+							<small class="text-muted">
+								{{ fournisseurs|length }} fournisseur(s)
+							</small>
+						</div>
+
+						<div class="ml-auto" style="min-width:260px;">
+							<input type="text" id="fournisseur-search" class="form-control" placeholder="Rechercher un fournisseur..." autocomplete="off">
+						</div>
+
+					</div>
+
+					<div class="table-responsive">
+
+						<table class="table table-bordered table-hover mb-0" id="fournisseurs-table">
+
+							<thead>
+								<tr>
+									<th>Nom</th>
+									<th>Téléphone</th>
+									<th>E-mail</th>
+									<th class="text-center">Statut</th>
+									<th class="text-center">Actions</th>
+								</tr>
+							</thead>
+
+							<tbody>
+
+								{% for fournisseur in fournisseurs %}
+
+									<tr class="fournisseur-row" data-search="{{ fournisseur.nom|default('') }} {{ fournisseur.email|default('') }} {{ fournisseur.telephone|default('') }}">
+
+										<td class="align-middle">
+											<a href="{{ path('app_fournisseur_show', {id: fournisseur.id}) }}">
+												<strong>{{ fournisseur.nom }}</strong>
+											</a>
+										</td>
+
+										<td class="align-middle">
+											{{ fournisseur.telephone|default('—') }}
+										</td>
+
+										<td class="align-middle">
+											{{ fournisseur.email|default('—') }}
+										</td>
+
+										<td class="align-middle text-center">
+											{% if fournisseur.actif %}
+												<span class="badge badge-success">Actif</span>
+											{% else %}
+												<span class="badge badge-light">Inactif</span>
+											{% endif %}
+										</td>
+
+										<td class="align-middle text-center nowrap">
+											<div class="btn-group">
+												<a href="{{ path('app_fournisseur_show', {id: fournisseur.id}) }}" class="btn btn-sm btn-primary-light" title="Voir">
+													<i class="fa fa-eye"></i>
+												</a>
+												<a href="{{ path('app_fournisseur_edit', {id: fournisseur.id}) }}" class="btn btn-sm btn-warning-light" title="Modifier">
+													<i class="fa fa-pencil"></i>
+												</a>
+											</div>
+										</td>
+
+									</tr>
+
+								{% else %}
+
+									<tr>
+										<td colspan="5" class="text-center text-muted py-5">
+											Aucun fournisseur enregistré.
+										</td>
+									</tr>
+
+								{% endfor %}
+
+							</tbody>
+
+						</table>
+
+					</div>
+
+				</div>
+
+			</div>
+
+		</div>
+
+	</div>
+
+{% endblock %}
+
+
+{% block javascripts %}
+
+	{{ parent() }}
+
+	<script>
+		document.addEventListener('DOMContentLoaded', function () {
+
+			const searchInput = document.getElementById('fournisseur-search');
+			const rows = document.querySelectorAll('#fournisseurs-table .fournisseur-row');
+
+			function normaliser(valeur) {
+				return (valeur || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
+			}
+
+			if (searchInput) {
+				searchInput.addEventListener('input', function () {
+					const recherche = normaliser(searchInput.value);
+
+					rows.forEach(function (row) {
+						const contenu = normaliser(row.dataset.search || row.textContent);
+						row.style.display = (recherche === '' || contenu.includes(recherche)) ? '' : 'none';
+					});
+				});
+			}
+
+		});
+	</script>
+
+{% endblock %}
