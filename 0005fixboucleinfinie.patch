From d4749050ab27db90de4acfb056edf35ab0c60ac5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 23:53:14 +0000
Subject: [PATCH] Corriger une boucle infinie dans definirValeur() (RangeError
 stack overflow)

Le champ surface porte la classe js-calcul-detail. calculerDetail()
l'ecrivait systematiquement via definirValeur(), qui declenche
toujours un evenement input, meme quand la valeur ne change pas.
Cet evenement remonte jusqu'au listener delegue sur .js-calcul-detail
et relance calculerDetail(), qui reecrit surface, etc. -> recursion
infinie jusqu'a RangeError: Maximum call stack size exceeded.

definirValeur() ne declenche desormais l'evenement input que si la
valeur du champ change reellement.
---
 templates/commandes/_form.html.twig | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/templates/commandes/_form.html.twig b/templates/commandes/_form.html.twig
index c3f1b1a..a9ff071 100644
--- a/templates/commandes/_form.html.twig
+++ b/templates/commandes/_form.html.twig
@@ -2018,7 +2018,19 @@ if (valeur && typeof valeur === 'object' && valeur.id !== undefined) {
 valeur = valeur.id;
 }
 
-champ.value = valeur === null || valeur === undefined ? '' : String(valeur);
+const nouvelleValeur = valeur === null || valeur === undefined ? '' : String(valeur);
+
+/*
+     * Évite une boucle infinie : certains champs calculés (ex. surface)
+     * portent la classe js-calcul-detail. Sans ce garde-fou, les
+     * redéfinir déclenche l'événement input, qui relance calculerDetail(),
+     * qui les redéfinit à nouveau, etc.
+     */
+if (champ.value === nouvelleValeur) {
+return;
+}
+
+champ.value = nouvelleValeur;
 
 if (champ.tagName === 'SELECT' && window.jQuery && window.jQuery.fn.select2) {
 window.jQuery(champ).val(champ.value).trigger('change.select2');
-- 
