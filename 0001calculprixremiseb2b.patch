+/*
+         * ====================================================
+         * PRODUIT MANUEL AJAX
+         * ====================================================
+         */
+
+function filtrerOptions(select, idsAutorises) {
+if (! select) {
+return;
+}
+
+const autorises = new Set((idsAutorises || []).map(String));
+
+let valeurEncoreValide = false;
+
+Array.from(select.options).forEach(function (option) {
+if (! option.value) {
+return;
+}
+
+const visible = autorises.has(String(option.value));
+
+option.hidden = ! visible;
+
+option.disabled = ! visible;
+
+if (visible && option.value === select.value) {
+valeurEncoreValide = true;
+}
+});
+
+if (! valeurEncoreValide) {
+select.value = '';
+}
+
+if (window.jQuery && window.jQuery.fn.select2 && window.jQuery(select).hasClass('select2-hidden-accessible')) {
+window.jQuery(select).trigger('change.select2');
+}
+}
+
+
+async function chargerOptionsManuelles(detail) {
+if (valeurTypeLigne(detail) !== 'produit' || valeurModeConfiguration(detail) !== 'manuel') {
+return;
+}
+
+const produit = champDetail(detail, 'produit');
+
+if (! produit || ! produit.value) {
+return;
+}
+
+
+try {
+
+const response = await fetch(construireUrl(optionsManuellesUrl, produit.value));
+
+const json = await response.json();
+
+if (! response.ok || ! json.success) {
+throw new Error(json.message || 'Impossible de charger le produit.');
+}
+
+const infosProduit = json.produit || {};
+
+
+definirValeur(detail, 'prixUnitaire', infosProduit.prixBase || 0);
+
+definirValeur(detail, 'remise', Math.round(infosProduit.remiseB2B || 0));
+
+definirValeur(detail, 'modeCalcul', infosProduit.modeCalcul || 'unite');
+
+
+filtrerOptions(champDetail(detail, 'typeImpression'), (json.typesImpression || []).map(function (t) {
+return t.id;
+}));
+
+filtrerOptions(champDetail(detail, 'support'), (json.supports || []).map(function (s) {
+return s.id;
+}));
+
+filtrerOptions(champDetail(detail, 'format'), (json.formats || []).map(function (f) {
+return f.id;
+}));
+
+
+calculerDetail(detail);
+
+
+} catch (e) {
+
