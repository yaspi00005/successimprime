From 1684477ca32e14e8b55a2f626b6fd194aec21e5c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 23:48:36 +0000
Subject: [PATCH] Ajouter l'upload de fichiers par morceaux avec barre de
 progression

Le formulaire de commande exposait deja les URLs d'upload (initialiser,
morceau, statut) via des attributs data- sur <form>, ainsi qu'un input
file et une zone .js-liste-uploads, mais aucun JS ne les utilisait :
selectionner un fichier ne faisait rien.

- televerserFichier() : decoupe le fichier en morceaux de 2 Mo, appelle
  /commande-fichiers/initialiser puis POST un morceau a la fois vers
  /commande-fichiers/{jeton}/morceaux/{index}, avec le jeton CSRF
  upload-commande attendu par FichierUploadController.
- Barre de progression Bootstrap par fichier (uploads-ligne), passe au
  vert une fois termine, rouge avec message d'erreur en cas d'echec.
- ajouterJetonFichier() alimente le champ cache jetonsFichiers en CSV,
  format attendu par CommandesController::rattacherFichiers() a la
  validation de la commande.
---
 templates/commandes/_form.html.twig | 207 ++++++++++++++++++++++++++++
 1 file changed, 207 insertions(+)

diff --git a/templates/commandes/_form.html.twig b/templates/commandes/_form.html.twig
index 3b8da6e..c3f1b1a 100644
--- a/templates/commandes/_form.html.twig
+++ b/templates/commandes/_form.html.twig
@@ -1480,6 +1480,26 @@
 		border-radius: 6px;
 	}
 
+	.upload-ligne {
+		padding: 10px 12px;
+		background: #fff;
+		border: 1px solid #e5eaf2;
+		border-radius: 6px;
+	}
+
+	.upload-ligne + .upload-ligne {
+		margin-top: 8px;
+	}
+
+	.upload-ligne .progress {
+		border-radius: 4px;
+		background-color: #eef1f6;
+	}
+
+	.upload-ligne .upload-barre {
+		transition: width .2s ease;
+	}
+
 	.detail-commande-verrouille {
 		opacity: .95;
 	}
@@ -2787,6 +2807,173 @@ console.error(e);
 }
 
 
+/*
+         * ====================================================
+         * UPLOAD FICHIERS PAR MORCEAUX
+         * ====================================================
+         */
+
+const TAILLE_MORCEAU_UPLOAD = 2 * 1024 * 1024;
+
+
+function ajouterJetonFichier(detail, jeton) {
+const champ = detail.querySelector('.js-jetons-fichiers') || champDetail(detail, 'jetonsFichiers');
+
+if (! champ) {
+return;
+}
+
+const existants = String(champ.value || '').split(',').map(function (valeur) {
+return valeur.trim();
+}).filter(Boolean);
+
+if (existants.indexOf(jeton) === -1) {
+existants.push(jeton);
+}
+
+champ.value = existants.join(',');
+}
+
+
+function creerLigneUpload(liste, nomFichier) {
+const ligne = document.createElement('div');
+
+ligne.className = 'upload-ligne mb-2';
+
+ligne.innerHTML = '<div class="d-flex justify-content-between align-items-center mb-1">' + '<span class="upload-nom text-truncate" style="max-width:70%;" title="' + nomFichier.replace(/"/g, '&quot;') + '">' + nomFichier + '</span>' + '<span class="upload-pourcentage small text-muted">0 %</span>' + '</div>' + '<div class="progress" style="height:6px;">' + '<div class="progress-bar bg-primary upload-barre" role="progressbar" style="width:0%;"></div>' + '</div>' + '<div class="upload-message small text-danger mt-1"></div>';
+
+liste.appendChild(ligne);
+
+return {
+barre: ligne.querySelector('.upload-barre'),
+pourcentage: ligne.querySelector('.upload-pourcentage'),
+message: ligne.querySelector('.upload-message')
+};
+}
+
+
+async function televerserFichier(detail, fichier) {
+
+const liste = detail.querySelector('.js-liste-uploads');
+
+if (! liste) {
+return;
+}
+
+
+const csrf = form.dataset.uploadCsrf;
+
+const urlInitialiser = form.dataset.uploadInitialiserUrl;
+
+const modeleUrlMorceau = form.dataset.uploadMorceauUrl;
+
+
+if (! csrf || ! urlInitialiser || ! modeleUrlMorceau) {
+return;
+}
+
+
+const ui = creerLigneUpload(liste, fichier.name);
+
+
+function definirProgression(valeur) {
+const pourcentageArrondi = Math.max(0, Math.min(100, Math.round(valeur)));
+
+ui.barre.style.width = pourcentageArrondi + '%';
+
+ui.pourcentage.textContent = pourcentageArrondi + ' %';
+}
+
+
+const nombreMorceaux = Math.max(1, Math.ceil(fichier.size / TAILLE_MORCEAU_UPLOAD));
+
+
+try {
+
+const reponseInit = await fetch(urlInitialiser, {
+method: 'POST',
+headers: {
+'Content-Type': 'application/json',
+Accept: 'application/json',
+'X-CSRF-TOKEN': csrf
+},
+body: JSON.stringify({
+nom: fichier.name,
+typeMime: fichier.type || 'application/octet-stream',
+taille: fichier.size,
+nombreMorceaux: nombreMorceaux
+})
+});
+
+const donneesInit = await reponseInit.json();
+
+if (! reponseInit.ok || ! donneesInit.jeton) {
+throw new Error(donneesInit.message || 'Impossible de démarrer l’envoi du fichier.');
+}
+
+const jeton = donneesInit.jeton;
+
+
+for (let index = 0; index < nombreMorceaux; index++) {
+
+const debut = index * TAILLE_MORCEAU_UPLOAD;
+
+const fin = Math.min(fichier.size, debut + TAILLE_MORCEAU_UPLOAD);
+
+const morceau = fichier.slice(debut, fin);
+
+
+const donneesMorceau = new FormData();
+
+donneesMorceau.append('morceau', morceau, fichier.name);
+
+
+const urlMorceau = modeleUrlMorceau.replace('__JETON__', encodeURIComponent(jeton)).replace('__INDEX__', String(index));
+
+
+const reponseMorceau = await fetch(urlMorceau, {
+method: 'POST',
+headers: {
+'X-CSRF-TOKEN': csrf
+},
+body: donneesMorceau
+});
+
+const donneesMorceauJson = await reponseMorceau.json();
+
+if (! reponseMorceau.ok) {
+throw new Error(donneesMorceauJson.message || 'Envoi du fichier interrompu.');
+}
+
+definirProgression(donneesMorceauJson.progression !== undefined ? donneesMorceauJson.progression : ((index + 1) / nombreMorceaux) * 100);
+}
+
+
+definirProgression(100);
+
+ui.pourcentage.textContent = 'Terminé';
+
+ui.barre.classList.remove('bg-primary');
+
+ui.barre.classList.add('bg-success');
+
+
+ajouterJetonFichier(detail, jeton);
+
+
+} catch (erreur) {
+
+console.error('[Upload]', erreur);
+
+ui.barre.classList.remove('bg-primary');
+
+ui.barre.classList.add('bg-danger');
+
+ui.message.textContent = erreur.message || 'Erreur lors de l’envoi du fichier.';
+}
+}
+
+
 /*
          * ====================================================
          * VERROUILLAGE
@@ -2926,6 +3113,26 @@ appliquerCircuit(travail);
 });
 
 
+/*
+             * FICHIERS
+             */
+const inputFichiers = travail.querySelector('.js-fichiers-client');
+
+if (inputFichiers) {
+
+inputFichiers.addEventListener('change', function () {
+
+const fichiersSelectionnes = Array.from(inputFichiers.files || []);
+
+inputFichiers.value = '';
+
+fichiersSelectionnes.forEach(function (fichier) {
+televerserFichier(travail, fichier);
+});
+});
+}
+
+
 /*
              * SUPPRESSION
              */
