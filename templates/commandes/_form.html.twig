             */

definirValeur(detail, 'produit', '');

definirValeur(detail, 'configuration', '');

definirValeur(detail, 'typeImpression', '');

definirValeur(detail, 'support', '');

definirValeur(detail, 'format', '');


afficher(detail, '.js-zone-largeur', false);

afficher(detail, '.js-zone-longueur', false);

afficher(detail, '.js-zone-surface', false);

afficher(detail, '.js-zone-nombre-faces', false);


