<script>

	document.addEventListener('DOMContentLoaded', function () {

const form = document.getElementById('commande-form');

const collection = document.getElementById('collection-details');

const addButton = document.getElementById('add-detail');

if (! form || ! collection) {
return;
}


const commandeVerrouillee = form.dataset.circuitVerrouille === '1';


/*
         * ====================================================
         * CLIENT B2B / B2C
         * ====================================================
         */

const clientSelect = form.querySelector('.js-client-commande');

const profilClient = form.querySelector('.js-profil-client');

const profilClientAide = form.querySelector('.js-profil-client-aide');

console.log('[DEBUG] clientSelect trouve ?', !! clientSelect, clientSelect);
console.log('[DEBUG] profilClient trouve ?', !! profilClient);
console.log('[DEBUG] profilClientAide trouve ?', !! profilClientAide);
console.log('[DEBUG] commandeVerrouillee =', commandeVerrouillee);


function typeClientActuel() {

if (! clientSelect || ! clientSelect.value) {
return 'B2C';
}

const option = clientSelect.options[clientSelect.selectedIndex];

if (! option) {
return 'B2C';
}

const type = String(option.dataset.typeClient || 'B2C').trim().toUpperCase();

return type === 'B2B' ? 'B2B' : 'B2C';
}


function clientEstB2B() {
return typeClientActuel() === 'B2B';
}


function afficherProfilClient() {

console.log('[DEBUG] afficherProfilClient() appelee, clientSelect.value =', clientSelect ? clientSelect.value : '(pas de clientSelect)');

if (! profilClient || ! profilClientAide) {
console.log('[DEBUG] afficherProfilClient() : profilClient/profilClientAide introuvable, arret');
return;
}

if (! clientSelect || ! clientSelect.value) {
console.log('[DEBUG] afficherProfilClient() : clientSelect vide, affichage placeholder');
profilClient.textContent = 'Sélectionnez un client';
profilClientAide.textContent = 'Le tarif B2B ou B2C sera appliqué automatiquement.';
return;
}

if (clientEstB2B()) {
profilClient.textContent = 'Client B2B';
profilClientAide.textContent = 'Le tarif professionnel B2B est appliqué automatiquement lorsqu’il existe pour le produit.';
} else {
profilClient.textContent = 'Client B2C';
profilClientAide.textContent = 'Le prix public est appliqué, sans remise B2B.';
}
}


async function appliquerNouveauProfilClient() {

console.log('[DEBUG] appliquerNouveauProfilClient() DECLENCHE (changement client detecte)');

afficherProfilClient();

const details = collection.querySelectorAll('.detail-commande');

for (const detail of details) {

if (valeurTypeLigne(detail) !== 'produit') {
continue;
}

const mode = valeurModeConfiguration(detail);

if (mode === 'automatique') {
const configuration = champDetail(detail, 'configuration');

if (configuration && configuration.value) {
await chargerConfiguration(detail);
}
} else {
const produit = champDetail(detail, 'produit');

if (produit && produit.value) {
await chargerOptionsManuelles(detail);
}
}
}

calculerCommande();
}


/*
         * ====================================================
         * URLS
         * ====================================================
         */

const configurationsProduitUrl = "{{ path(
                'app_commande_catalogue_produit',
                {'id': 0}
            ) }}";

const configurationUrl = "{{ path(
                'app_commande_catalogue_configuration',
                {'id': 0}
            ) }}";

const optionsManuellesUrl = "{{ path(
                'app_commande_catalogue_options_manuelles',
                {'id': 0}
            ) }}";

const articleCommandeUrl = "{{ path(
                'app_article_commande_ajax',
                {'id': 0}
            ) }}";


/*
         * ====================================================
         * HELPERS
         * ====================================================
         */

function construireUrl(modele, id) {
return modele.replace('/0/', '/' + encodeURIComponent(id) + '/');
}


function champDetail(detail, nom) {
return detail.querySelector('[data-detail-field="' + nom + '"],' + '[name$="[' + nom + ']"]');
}


function nombreDepuisChamp(champ, valeurDefaut = 0) {
if (! champ || champ.value === '') {
return valeurDefaut;
}

const valeur = Number(String(champ.value).replace(',', '.'));

return Number.isFinite(valeur) ? valeur : valeurDefaut;
}


function formaterNombre(valeur, decimals = 3) {
return Number(valeur || 0).toLocaleString('fr-FR', {maximumFractionDigits: decimals});
}


function formaterMontant(valeur) {
return Math.round(Number(valeur || 0)).toLocaleString('fr-FR');
}


function definirValeur(detail, champNom, valeur) {
const champ = champDetail(detail, champNom);

if (! champ) {
return;
}

if (valeur && typeof valeur === 'object' && valeur.id !== undefined) {
valeur = valeur.id;
}

const nouvelleValeur = valeur === null || valeur === undefined ? '' : String(valeur);

/*
 * Garde anti-recursion : certains champs (ex. "surface") portent
 * la classe js-calcul-detail et redeclenchent calculerDetail() sur
 * l'evenement "input". Sans ce garde-fou, calculerDetail() ->
 * definirValeur() -> input -> calculerDetail() -> ... boucle
 * indefiniment (RangeError: Maximum call stack size exceeded).
 * Si la valeur ne change pas reellement, on ne redispatche rien.
 */
if (champ.value === nouvelleValeur) {
return;
}

champ.value = nouvelleValeur;

if (champ.tagName === 'SELECT' && window.jQuery && window.jQuery.fn.select2) {
window.jQuery(champ).val(champ.value).trigger('change.select2');
}

champ.dispatchEvent(new Event('input', {bubbles: true}));
}


function valeurTypeLigne(detail) {
const radio = detail.querySelector('[name$="[typeLigne]"]:checked');

if (radio) {
return radio.value;
}

const champ = champDetail(detail, 'typeLigne');

return champ ? champ.value : 'produit';
}


function valeurModeConfiguration(detail) {
const radio = detail.querySelector('[name$="[modeConfiguration]"]:checked');

if (radio) {
return radio.value;
}

const champ = champDetail(detail, 'modeConfiguration');

return champ ? champ.value : 'automatique';
}


function afficher(detail, selecteur, visible) {
const zone = detail.querySelector(selecteur);

if (zone) {
zone.style.display = visible ? '' : 'none';
}
}


/*
         * ====================================================
         * SELECT2
         * ====================================================
         */

function initialiserSelect2(scope) {
if (!window.jQuery || !window.jQuery.fn.select2) {
return;
}

window.jQuery(scope).find('select.js-select-search').each(function () {

const select = window.jQuery(this);

if (select.hasClass('select2-hidden-accessible')) {
return;
}

select.select2({
width: '100%',

allowClear: true,

placeholder: select.data('placeholder') || 'Rechercher...',

/*
 * filtrerOptions() marque les options incompatibles avec
 * option.disabled = true (type d'impression / support / format
 * non lies au produit choisi en mode manuel). Select2 construit
 * sa propre liste deroulante et ignore par defaut les attributs
 * "hidden"/"disabled" du <select> natif : sans ce matcher, les
 * options desactivees restaient visibles et selectionnables dans
 * le menu Select2, alors qu'elles ne l'etaient plus dans le
 * <select> natif.
 */
matcher: function (params, data) {
if (data.element && data.element.disabled) {
return null;
}

const terme = (params.term || '').trim().toUpperCase();

if (terme === '') {
return data;
}

const texte = (data.text || '').toUpperCase();

return texte.indexOf(terme) > -1 ? data : null;
}
});

});
}


/*
         * ====================================================
         * CALCUL
         * ====================================================
         */

function montantFinitions(detail) {
if (valeurTypeLigne(detail) !== 'produit') {
return 0;
}

const automatiques = Array.from(detail.querySelectorAll('.js-finition-selectionnee:checked')).reduce(function (total, checkbox) {
return total + Number(checkbox.dataset.prix || 0);
}, 0);

/*
 * Finitions manuelles : simple apercu cote client (forfait =
 * prix fixe, sinon prix x quantite). Le montant definitif de
 * chaque ligne est recalcule cote serveur a l'enregistrement.
 */
const manuelles = Array.from(detail.querySelectorAll('.js-finition-manuelle')).reduce(function (total, ligne) {
const prix = Number(ligne.querySelector('.js-finition-prix') ?. value || 0);
const quantite = Math.max(1, Number(ligne.querySelector('.js-finition-quantite') ?. value || 1));
const mode = ligne.querySelector('.js-finition-mode') ?. value || 'forfait';

return total + (mode === 'forfait' ? prix : prix * quantite);
}, 0);

return automatiques + manuelles;
}


function calculerDetail(detail) {
const quantite = Math.max(1, nombreDepuisChamp(champDetail(detail, 'quantite'), 1));

const largeur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'largeur')));

const longueur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'longueur')));

const surface = largeur * longueur;

const prix = Math.max(0, nombreDepuisChamp(champDetail(detail, 'prixUnitaire')));

const remise = Math.min(100, Math.max(0, nombreDepuisChamp(champDetail(detail, 'remise'))));

const tva = Math.max(0, nombreDepuisChamp(champDetail(detail, 'tva')));

const mode = String(champDetail(detail, 'modeCalcul') ?. value || 'unite');

let montant = 0;

switch (mode) {

case 'forfait': montant = prix;

break;


case 'metre': montant = prix * longueur * quantite;

break;


case 'metre_carre': montant = prix * surface * quantite;

break;


default: montant = prix * quantite;

break;
}


montant += montantFinitions(detail);


const ht = Math.max(0, montant * (1 - remise / 100));

const ttc = ht * (1 + tva / 100);


definirValeur(detail, 'surface', surface);

definirValeur(detail, 'totalHt', Math.round(ht));

definirValeur(detail, 'totalTtc', Math.round(ttc));


calculerCommande();
}


function calculerCommande() {

let ht = 0;
let ttc = 0;

collection.querySelectorAll('.detail-commande').forEach(function (detail) {
ht += nombreDepuisChamp(champDetail(detail, 'totalHt'));

ttc += nombreDepuisChamp(champDetail(detail, 'totalTtc'));
});


const totalHt = document.getElementById('{{ form.totalHt.vars.id }}');

const totalTtc = document.getElementById('{{ form.totalTtc.vars.id }}');

const remise = document.getElementById('{{ form.remise.vars.id }}');

const payer = document.getElementById('{{ form.montantApayer.vars.id }}');


if (totalHt) {
totalHt.value = Math.round(ht);
}

if (totalTtc) {
totalTtc.value = Math.round(ttc);
}

if (payer) {

payer.value = Math.max(0, Math.round(ttc - nombreDepuisChamp(remise)));
}
}


/*
         * ====================================================
         * CIRCUIT
         * ====================================================
         */

function appliquerCircuit(detail) {
const prepresse = detail.querySelector('.js-prepresse-necessaire');

const production = detail.querySelector('.js-production-necessaire');

const message = detail.querySelector('.js-message-circuit-texte');

if (! prepresse || ! production || ! message) {
return;
}


if (! prepresse.checked && ! production.checked) {
message.textContent = 'Livraison directe.';

return;
}


if (! prepresse.checked && production.checked) {
message.textContent = 'Production directe puis livraison.';

return;
}


if (prepresse.checked && production.checked) {
message.textContent = 'Prépresse, production puis livraison.';

return;
}


message.textContent = 'Prépresse puis livraison.';
}


