function montantFinitionsManuelles(detail) {
return Array.from(detail.querySelectorAll('.js-finition-manuelle')).reduce(function (total, ligne) {
const prix = Math.max(0, nombreDepuisChamp(ligne.querySelector('.js-finition-prix')));

const quantite = Math.max(1, nombreDepuisChamp(ligne.querySelector('.js-finition-quantite'), 1));

const champMode = ligne.querySelector('.js-finition-mode');

const mode = champMode ? String(champMode.value).toLowerCase() : 'forfait';

const largeur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'largeur')));

const longueur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'longueur')));

const surface = largeur * longueur;

const nombreFaces = Math.max(1, nombreDepuisChamp(champDetail(detail, 'nombreFaces'), 1));

let montant = prix;

switch (mode) {
case 'metre': montant = prix * longueur * quantite;
break;

case 'metre_carre': montant = prix * surface * quantite;
break;

case 'face': montant = prix * nombreFaces * quantite;
break;

case 'unite':
case 'feuille':
case 'exemplaire':
case 'heure':
case 'point': montant = prix * quantite;
break;

case 'forfait':
default: montant = prix;
break;
}

return total + montant;
}, 0);
}

