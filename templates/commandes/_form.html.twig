async function lireReponseJson(reponse) {
let donnees = {};

try {
donnees = await reponse.json();
} catch (erreur) {
donnees = {};
}

if (! reponse.ok) {
throw new Error(donnees.message || 'Une erreur est survenue pendant l’envoi.');
}

return donnees;
}

async function initialiserUpload(fichier, nombreMorceaux) {
if (! initialiserUrl) {
throw new Error('La route d\'initialisation de l\'upload est absente.');
}

const reponse = await fetch(initialiserUrl, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'X-CSRF-TOKEN': csrfToken
},
body: JSON.stringify(
{
nom: fichier.name,
typeMime: fichier.type || 'application/octet-stream',
taille: fichier.size,
nombreMorceaux: nombreMorceaux
}
)
});

return lireReponseJson(reponse);
}

async function envoyerMorceau(jeton, index, morceau) {
if (! modeleUrlMorceau) {
throw new Error('La route d\'envoi des morceaux est absente.');
}

const donnees = new FormData();

donnees.append('morceau', morceau, 'morceau-' + index + '.part');

const url = modeleUrlMorceau.replace('__JETON__', encodeURIComponent(jeton)).replace('__INDEX__', String(index));

const reponse = await fetch(url, {
method: 'POST',
headers: {
'X-CSRF-TOKEN': csrfToken
},
body: donnees
});

return lireReponseJson(reponse);
}

async function verifierStatutUpload(jeton) {
if (! modeleUrlStatut) {
return null;
}

const url = modeleUrlStatut.replace('__JETON__', encodeURIComponent(jeton));

const reponse = await fetch(url, {
method: 'GET',
headers: {
'X-CSRF-TOKEN': csrfToken
}
});

return lireReponseJson(reponse);
}

async function envoyerFichier(fichier, champJetons, liste) {
const ligne = creerLigneUpload(fichier, liste);

if (fichier.size <= 0) {
signalerErreur(ligne, 'Le fichier est vide.');
throw new Error('Le fichier est vide.');
}

uploadsActifs++;

try {
const nombreMorceaux = Math.ceil(fichier.size / tailleMorceau);

const session = await initialiserUpload(fichier, nombreMorceaux);

const jeton = session.jeton;

if (! jeton || !/^[a-f0-9]{64}$/.test(jeton)) {
throw new Error('Le serveur n\'a pas retourné un jeton d\'upload valide.');
}

for (let index = session.morceauxRecus || 0; index < nombreMorceaux; index++) {
const debut = index * tailleMorceau;
const fin = Math.min(debut + tailleMorceau, fichier.size);

const morceau = fichier.slice(debut, fin);

const resultat = await envoyerMorceau(jeton, index, morceau);

mettreAJourProgression(ligne, resultat.progression, 'Envoi du morceau ' + (
index + 1
) + ' sur ' + nombreMorceaux);
}

const statutFinal = await verifierStatutUpload(jeton);

if (! statutFinal || String(statutFinal.statut || '').toUpperCase() !== 'TERMINE') {
throw new Error(statutFinal.message || 'Le serveur n\'a pas confirmé la fin de l\'upload.');
}

ajouterJeton(champJetons, jeton);

const barre = ligne.querySelector('.js-barre-upload');
const statut = ligne.querySelector('.js-statut-upload');

barre.classList.add('bg-success');

statut.classList.remove('text-muted', 'text-danger');
statut.classList.add('text-success');

mettreAJourProgression(ligne, 100, 'Fichier envoyé avec succès.');
} catch (erreur) {
signalerErreur(ligne, erreur.message || 'Échec de l’envoi.');
throw erreur;
} finally {
uploadsActifs--;
}
}

