<script>
	document.addEventListener('DOMContentLoaded', function () {
console.log('✅ JavaScript commande chargé');
const form = document.getElementById('commande-form');
const collection = document.getElementById('collection-details');
const addButton = document.getElementById('add-detail');

if (! form || ! collection || ! addButton) {
return;
}

const csrfToken = form.dataset.uploadCsrf;
const initialiserUrl = form.dataset.uploadInitialiserUrl;
const modeleUrlMorceau = form.dataset.uploadMorceauUrl;
const modeleUrlStatut = form.dataset.uploadStatutUrl;
const tailleMorceau = 5 * 1024 * 1024;

if (! csrfToken || ! initialiserUrl || ! modeleUrlMorceau) {
console.error('Configuration de l\'upload incomplète : vérifiez les attributs data-upload-* du formulaire.');
}

const configurationsProduitUrl = "{{ path(
        'app_produit_configuration_by_produit_ajax',
        {id: 0}
    ) }}";

const configurationUrl = "{{ path(
        'app_produit_configuration_get_ajax',
        {id: 0}
    ) }}";
let uploadsActifs = 0;
/*
 * Conserve les configurations chargées pour chaque travail.
 * Elles servent à construire les listes du mode manuel.
 */
const configurationsParDetail = new WeakMap();
function construireUrl(url, id) {
return url.replace(/\/0(?=\/ajax(?:\?|$))/, '/' + encodeURIComponent(id));
}

function actualiserSelect2(select) {
if (! select) {
return;
}

if (typeof window.jQuery !== 'undefined' && typeof window.jQuery.fn.select2 !== 'undefined') {
window.jQuery(select).trigger('change.select2');
}
}

function viderSelect(select, placeholder) {
if (! select) {
return;
}

select.innerHTML = '';

const option = document.createElement('option');

option.value = '';
option.textContent = placeholder;

select.appendChild(option);
select.value = '';

actualiserSelect2(select);
}

function libelleFinition(finition) {
let libelle = finition.nom || 'Finition';

if (finition.payante && Number(finition.prix) > 0) {
libelle += ' — ' + Number(finition.prix).toLocaleString('fr-FR') + ' FCFA';
}

if (finition.obligatoire) {
libelle += ' — obligatoire';
}

return libelle;
}

function nombreDepuisChamp(champ, valeurParDefaut = 0) {
if (! champ || champ.value === '') {
return valeurParDefaut;
}

const valeur = Number(String(champ.value).replace(',', '.'));

return Number.isFinite(valeur) ? valeur : valeurParDefaut;
}

function champDetail(detail, nomChamp) {
return detail.querySelector('[data-detail-field="' + nomChamp + '"],' + '[name$="[' + nomChamp + ']"]');
}

function ecrireMontant(champ, valeur) {
if (! champ) {
return;
}

const montant = Number.isFinite(valeur) ? Math.round((valeur + Number.EPSILON) * 100) / 100 : 0;

champ.value = String(montant);
}


function prixFinitionsSelectionnees(detail) {
const largeur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'largeur')));

const longueur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'longueur')));

const surface = largeur > 0 && longueur > 0 ? largeur * longueur : 0;

const quantite = Math.max(1, nombreDepuisChamp(champDetail(detail, 'quantite'), 1));

return Array.from(detail.querySelectorAll('.js-finition-selectionnee:checked')).reduce(function (total, checkbox) {
const prix = Math.max(0, Number(checkbox.dataset.prix || 0));

const mode = String(checkbox.dataset.modeCalcul || 'forfait').toLowerCase();

if (mode === 'metre_carre' || mode === 'm2' || mode === 'surface') {
return total + prix * surface * quantite;
}

if (mode === 'metre') {
return total + prix * longueur * quantite;
}

if (mode === 'unite' || mode === 'quantite' || mode === 'par_unite' || mode === 'heure') {
return total + prix * quantite;
}

return total + prix;
}, 0);
}

function calculerRecapitulatif() {
let totalHtCommande = 0;
let totalTtcCommande = 0;

collection.querySelectorAll('.detail-commande').forEach(function (detail) {
totalHtCommande += nombreDepuisChamp(champDetail(detail, 'totalHt'));

totalTtcCommande += nombreDepuisChamp(champDetail(detail, 'totalTtc'));
});

const totalHt = document.getElementById('{{ form.totalHt.vars.id }}');
const totalTtc = document.getElementById('{{ form.totalTtc.vars.id }}');
const remiseCommande = document.getElementById('{{ form.remise.vars.id }}');
const montantApayer = document.getElementById('{{ form.montantApayer.vars.id }}');

const remise = Math.max(0, nombreDepuisChamp(remiseCommande));

ecrireMontant(totalHt, totalHtCommande);
ecrireMontant(totalTtc, totalTtcCommande);
ecrireMontant(montantApayer, Math.max(0, totalTtcCommande - remise));
}

function calculerDetail(detail) {
const largeur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'largeur')));

const longueur = Math.max(0, nombreDepuisChamp(champDetail(detail, 'longueur')));

const quantite = Math.max(1, nombreDepuisChamp(champDetail(detail, 'quantite'), 1));

const prixUnitaire = Math.max(0, nombreDepuisChamp(champDetail(detail, 'prixUnitaire')));

const remisePourcentage = Math.min(100, Math.max(0, nombreDepuisChamp(champDetail(detail, 'remise'))));

const tva = Math.max(0, nombreDepuisChamp(champDetail(detail, 'tva')));

const surface = largeur > 0 && longueur > 0 ? largeur * longueur : 0;

const champModeCalcul = champDetail(detail, 'modeCalcul');

const modeCalcul = String(champModeCalcul ? champModeCalcul.value : (detail.dataset.modeCalcul || 'unite')).toLowerCase();

let montantImpression = 0;

switch (modeCalcul) {
case 'forfait': montantImpression = prixUnitaire;
break;

case 'metre': montantImpression = prixUnitaire * longueur * quantite;
break;

case 'metre_carre': montantImpression = prixUnitaire * surface * quantite;
break;

case 'face': montantImpression = prixUnitaire * Math.max(1, nombreDepuisChamp(champDetail(detail, 'nombreFaces'), 1)) * quantite;
break;

case 'heure':
case 'feuille':
case 'exemplaire':
case 'point':
case 'unite':
default: montantImpression = prixUnitaire * quantite;
break;
}

const modeConfiguration = valeurModeConfiguration(detail);

const montantFinitions = modeConfiguration === 'automatique' ? prixFinitionsSelectionnees(detail) : montantFinitionsManuelles(detail);

const totalBrut = montantImpression + montantFinitions;

const totalHt = Math.max(0, totalBrut * (1 - remisePourcentage / 100));

const totalTtc = totalHt * (1 + tva / 100);

ecrireMontant(champDetail(detail, 'surface'), surface);

ecrireMontant(champDetail(detail, 'totalHt'), totalHt);

ecrireMontant(champDetail(detail, 'totalTtc'), totalTtc);

calculerRecapitulatif();
}

function bindCalcul(detail) {
if (detail.dataset.calculBound === '1') {
calculerDetail(detail);
return;
}

detail.dataset.calculBound = '1';

detail.addEventListener('input', function (event) {
if (event.target.closest('.js-calcul-detail')) {
calculerDetail(detail);
}
});

detail.addEventListener('change', function (event) {
if (event.target.closest('.js-calcul-detail') || event.target.matches('input[name$="[finitionsSelectionnees][]"]')) {
calculerDetail(detail);
}
});

calculerDetail(detail);
}

function definirValeurChamp(detail, nomChamp, valeur) {
const champ = detail.querySelector('[data-detail-field="' + nomChamp + '"],' + '[name$="[' + nomChamp + ']"]');

if (! champ) {
console.warn('Champ introuvable dans le travail :', nomChamp);
return;
}

// Accepte aussi bien un identifiant qu'un objet { id: ... }
const valeurFinale = valeur !== null && typeof valeur === 'object' && valeur.id !== undefined ? valeur.id : valeur;

champ.value = valeurFinale === null || valeurFinale === undefined ? '' : String(valeurFinale);

if (champ.tagName === 'SELECT' && typeof window.jQuery !== 'undefined' && typeof window.jQuery.fn.select2 !== 'undefined') {
window.jQuery(champ).val(champ.value).trigger('change.select2');
}

champ.dispatchEvent(new Event('input', {bubbles: true}));
}
async function chargerConfiguration(detail, configurationId, finitionsAConserver = null) {
const finitionsBox = detail.querySelector('.js-finitions-box');
const finitionsInitiales = finitionsAConserver || Array.from(detail.querySelectorAll('input[name$="[finitionsSelectionnees][]"]:checked')).map(function (checkbox) {
return String(checkbox.value);
});

if (! configurationId) {
detail.dataset.modeDimension = '';
detail.dataset.modeCalcul = 'unite';
detail.dataset.quantiteMin = '1';
detail.dataset.quantiteMax = '';

definirValeurChamp(detail, 'typeImpression', '');
definirValeurChamp(detail, 'support', '');
definirValeurChamp(detail, 'format', '');
definirValeurChamp(detail, 'prixUnitaire', '');
definirValeurChamp(detail, 'largeur', '');
definirValeurChamp(detail, 'longueur', '');
definirValeurChamp(detail, 'surface', '');

const messageQuantite = detail.querySelector('.js-message-quantite');

if (messageQuantite) {
messageQuantite.textContent = '';
}

if (finitionsBox) {
finitionsBox.innerHTML = '<span class="text-muted">' + 'Sélectionnez une configuration.' + '</span>';
}

appliquerModeConfiguration(detail);
calculerDetail(detail);

return;
}

try {
const reponse = await fetch(construireUrl(configurationUrl, configurationId), {
headers: {
Accept: 'application/json'
}
});

if (! reponse.ok) {
throw new Error('Impossible de charger la configuration.');
}

const resultat = await reponse.json();
const configuration = resultat.configuration || resultat.data || resultat;
detail.dataset.modeDimension = String(configuration.modeDimension || '');

detail.dataset.modeCalcul = String(configuration.modeCalcul || 'unite');

detail.dataset.quantiteMin = String(configuration.quantiteMinimale ?? configuration.quantiteMin ?? 1);

detail.dataset.quantiteMax = String(configuration.quantiteMaximale ?? configuration.quantiteMax ?? '');

definirValeurChamp(detail, 'typeImpression', configuration.typeImpression);

definirValeurChamp(detail, 'support', configuration.support);

definirValeurChamp(detail, 'format', configuration.format);

if (configuration.prixBase !== null && configuration.prixBase !== undefined) {
definirValeurChamp(detail, 'prixUnitaire', configuration.prixBase);
}


/*
 * AJOUTER LA PARTIE ICI :
 * limites de quantité.
 */
const quantite = champDetail(detail, 'quantite');

const quantiteMin = Math.max(1, Number(detail.dataset.quantiteMin || 1));

const quantiteMax = detail.dataset.quantiteMax !== '' ? Number(detail.dataset.quantiteMax) : null;

if (quantite) {
quantite.min = String(quantiteMin);

if (quantiteMax !== null && Number.isFinite(quantiteMax)) {
quantite.max = String(quantiteMax);
} else {
quantite.removeAttribute('max');
}

if (quantite.value === '' || Number(quantite.value) < quantiteMin) {
quantite.value = String(quantiteMin);
}
}

const messageQuantite = detail.querySelector('.js-message-quantite');

if (messageQuantite) {
messageQuantite.textContent = quantiteMax !== null && Number.isFinite(quantiteMax) ? 'Quantité autorisée : ' + quantiteMin + ' à ' + quantiteMax + '.' : 'Quantité minimale : ' + quantiteMin + '.';
}

/*
 * Dimensions enregistrées dans la configuration.
 */
if (detail.dataset.modeDimension === 'mesure') {
definirValeurChamp(detail, 'largeur', configuration.largeurDefaut ?? configuration.largeur ?? '');

definirValeurChamp(detail, 'longueur', configuration.longueurDefaut ?? configuration.longueur ?? '');
} else {
definirValeurChamp(detail, 'largeur', '');
definirValeurChamp(detail, 'longueur', '');
definirValeurChamp(detail, 'surface', '');
}

/*
 * Le bloc déjà présent continue ici.
 */
if (finitionsBox) {
const nomChamp = finitionsBox.dataset.inputName;
finitionsBox.innerHTML = '';

const listeFinitions = configuration.finitions || configuration.configurationFinitions || [];

if (! listeFinitions.length) {
finitionsBox.innerHTML = '<span class="text-muted">Aucune finition disponible.</span>';
}

listeFinitions.forEach(function (finition, index) {
const donneesFinition = finition.finition || finition;
const identifiant = finition.id ?? donneesFinition.id;
const wrapper = document.createElement('div');
const checkbox = document.createElement('input');
const label = document.createElement('label');
const inputId = (nomChamp + '_' + index).replace(/[^a-zA-Z0-9_-]/g, '_');

wrapper.className = 'form-check form-check-inline';
checkbox.type = 'checkbox';
checkbox.className = 'form-check-input js-finition-selectionnee';
checkbox.name = nomChamp + '[]';
checkbox.id = inputId;
checkbox.value = String(identifiant);
checkbox.checked = finitionsInitiales.includes(String(identifiant)) || Boolean(finition.obligatoire || finition.selectionneeParDefaut);
checkbox.disabled = Boolean(finition.obligatoire);
checkbox.dataset.obligatoire = finition.obligatoire ? '1' : '0';
checkbox.dataset.prix = String(finition.prix ?? donneesFinition.prix ?? 0);
checkbox.dataset.modeCalcul = String(finition.modeCalcul ?? 'forfait');

/*
 * Une case disabled n'est pas envoyée par le navigateur.
 * On empêche donc seulement le décochage des finitions obligatoires.
 */
checkbox.disabled = false;
if (finition.obligatoire) {
checkbox.addEventListener('click', function (event) {
event.preventDefault();
checkbox.checked = true;
});
}

label.className = 'form-check-label';
label.htmlFor = inputId;
label.textContent = libelleFinition({
... donneesFinition,
... finition
});
wrapper.appendChild(checkbox);
wrapper.appendChild(label);
finitionsBox.appendChild(wrapper);
});
}


/*
 * Applique le verrouillage ou la saisie manuelle
 * après le chargement de la configuration.
 */
appliquerModeConfiguration(detail);
calculerDetail(detail);

} catch (erreur) {

if (finitionsBox) {
finitionsBox.innerHTML = '<span class="text-danger">Erreur de chargement.</span>';
}
}
}
function valeurObjet(objet, propriete) {
if (! objet || ! objet[propriete]) {
return null;
}

const valeur = objet[propriete];

if (typeof valeur !== 'object' || valeur.id === null || valeur.id === undefined) {
return null;
}

return {
id: String(valeur.id),
nom: valeur.nom || valeur.libelle || String(valeur.id)
};
}

function optionsUniques(configurations, propriete) {
const options = new Map();

configurations.forEach(function (configuration) {
const valeur = valeurObjet(configuration, propriete);

if (valeur) {
options.set(valeur.id, valeur);
}
});

return Array.from(options.values());
}

function remplirSelectManuel(select, options, placeholder, valeurAConserver = '') {
if (! select) {
return;
}

viderSelect(select, placeholder);

options.forEach(function (element) {
const option = document.createElement('option');

option.value = element.id;
option.textContent = element.nom;

select.appendChild(option);
});

if (valeurAConserver && options.some(function (element) {
return element.id === String(valeurAConserver);
})) {
select.value = String(valeurAConserver);
}

/*
     * Lorsqu’il n’existe qu’un seul choix,
     * il est sélectionné automatiquement.
     */
if (! select.value && options.length === 1) {
select.value = options[0].id;
}

actualiserSelect2(select);
}

function configurationsFiltrees(detail, inclureSupport = true, inclureFormat = true) {
const configurations = configurationsParDetail.get(detail) || [];

const typeSelect = champDetail(detail, 'typeImpression');

const supportSelect = champDetail(detail, 'support');

const formatSelect = champDetail(detail, 'format');

return configurations.filter(function (configuration) {
const typeImpression = valeurObjet(configuration, 'typeImpression');

const support = valeurObjet(configuration, 'support');

const format = valeurObjet(configuration, 'format');

if (typeSelect && typeSelect.value && (! typeImpression || typeImpression.id !== typeSelect.value)) {
return false;
}

if (inclureSupport && supportSelect && supportSelect.value && (! support || support.id !== supportSelect.value)) {
return false;
}

if (inclureFormat && formatSelect && formatSelect.value && (! format || format.id !== formatSelect.value)) {
return false;
}

return true;
});
}

function reinitialiserDonneesConfiguration(detail) {
detail.dataset.modeDimension = '';
detail.dataset.modeCalcul = 'unite';
detail.dataset.quantiteMin = '1';
detail.dataset.quantiteMax = '';

definirValeurChamp(detail, 'prixUnitaire', '');
definirValeurChamp(detail, 'largeur', '');
definirValeurChamp(detail, 'longueur', '');
definirValeurChamp(detail, 'surface', '');

const finitionsBox = detail.querySelector('.js-finitions-box');

if (finitionsBox) {
finitionsBox.innerHTML = '<span class="text-muted">' + 'Terminez la sélection pour afficher les finitions.' + '</span>';
}

calculerDetail(detail);
}

function initialiserChoixManuels(detail) {
const configurations = configurationsParDetail.get(detail) || [];

const typeSelect = champDetail(detail, 'typeImpression');

const supportSelect = champDetail(detail, 'support');

const formatSelect = champDetail(detail, 'format');

remplirSelectManuel(typeSelect, optionsUniques(configurations, 'typeImpression'), 'Sélectionnez un type d’impression');

viderSelect(supportSelect, 'Sélectionnez d’abord un type d’impression');

viderSelect(formatSelect, 'Sélectionnez d’abord un support');

reinitialiserDonneesConfiguration(detail);

/*
     * Continue automatiquement si le produit
     * ne possède qu’un seul type d’impression.
     */
if (typeSelect && typeSelect.value) {
actualiserSupportsManuels(detail);
}
}

function actualiserSupportsManuels(detail) {
const supportSelect = champDetail(detail, 'support');

const formatSelect = champDetail(detail, 'format');

const configurations = configurationsFiltrees(detail, false, false);

remplirSelectManuel(supportSelect, optionsUniques(configurations, 'support'), 'Sélectionnez un support');

viderSelect(formatSelect, 'Sélectionnez d’abord un support');

reinitialiserDonneesConfiguration(detail);

if (supportSelect && supportSelect.value) {
actualiserFormatsManuels(detail);
}
}

function actualiserFormatsManuels(detail) {
const formatSelect = champDetail(detail, 'format');

const configurations = configurationsFiltrees(detail, true, false);

const formats = optionsUniques(configurations, 'format');

remplirSelectManuel(formatSelect, formats, formats.length ? 'Sélectionnez un format' : 'Aucun format nécessaire');

reinitialiserDonneesConfiguration(detail);

/*
     * Pour une bâche au m², le format est généralement vide.
     * La configuration peut donc être trouvée dès le support.
     */
if (! formats.length || formatSelect.value) {
rechercherConfigurationManuelle(detail);
}
}

async function rechercherConfigurationManuelle(detail) {
const configurations = configurationsFiltrees(detail, true, true);

const formatSelect = champDetail(detail, 'format');

const configurationsAvecFormat = configurations.filter(function (configuration) {
return valeurObjet(configuration, 'format') !== null;
});

/*
     * Pour un produit par format, il faut choisir A3, A4, A5...
     */
if (configurationsAvecFormat.length && (! formatSelect || ! formatSelect.value)) {
return;
}

if (configurations.length !== 1) {
reinitialiserDonneesConfiguration(detail);
return;
}

const configuration = configurations[0];

const configurationSelect = champDetail(detail, 'configuration');

if (configurationSelect) {
configurationSelect.value = String(configuration.id);

actualiserSelect2(configurationSelect);
}

await chargerConfiguration(detail, configuration.id);
}

