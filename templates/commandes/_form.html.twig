afficher(detail, '.js-zone-champs-configuration', produit);

afficher(detail, '.js-zone-article-stock', article);

afficher(detail, '.js-zone-finitions', produit);

afficher(detail, '.js-zone-technique', produit);

afficher(detail, '.js-zone-fichiers', produit);


