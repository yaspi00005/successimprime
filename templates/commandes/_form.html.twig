{% macro finition_manuelle(finition) %}
	<div class="js-finition-manuelle border rounded p-3 mb-3">
		<div class="row align-items-end">
			<div class="col-lg-4 col-md-6">
				{{ form_row(finition.finition, {
                    label: 'Finition',
                    attr: {
                        class: 'form-control js-select-search'
                    }
                }) }}
			</div>

			<div class="col-lg-2 col-md-6">
				{{ form_row(finition.prixApplique, {
                    label: 'Prix appliqué',
                    attr: {
                        class: 'form-control js-finition-prix',
                        min: 0
                    }
                }) }}
			</div>

			<div class="col-lg-2 col-md-6">
				{{ form_row(finition.modeCalcul, {
                    label: 'Mode de calcul',
                    attr: {
                        class: 'form-control js-finition-mode'
                    }
                }) }}
			</div>

			<div class="col-lg-2 col-md-6">
				{{ form_row(finition.quantite, {
                    label: 'Quantité',
                    attr: {
                        class: 'form-control js-finition-quantite',
                        min: 1
                    }
                }) }}
			</div>

			<div class="col-lg-2 col-md-6">
				<button type="button" class="btn btn-danger-light btn-block js-supprimer-finition">
					<i class="fa fa-trash mr-1"></i>
					Supprimer
				</button>
			</div>
		</div>
	</div>
{% endmacro %}
{% macro champs_detail(detail) %}
	<div class="travail-form js-commande-detail">
		<div class="travail-section">
			<div class="travail-section-title">
				<i class="fa fa-cube"></i>
				Produit et configuration
			</div>
			<div class="travail-section">

				<div class="travail-section-title">
					<i class="fa fa-random"></i>
					Circuit de traitement
				</div>

				<div class="row">

					<div class="col-lg-6 col-md-6">

						<div class="form-group">

							{{ form_row(detail.prePresseNecessaire, {
                    label: 'Passage en prépresse',
                    attr: {
                        class: 'js-prepresse-necessaire'
                    }
                }) }}

							<small class="form-text text-muted">
								Activez cette option si le fichier doit être contrôlé,
																																																																																								                    préparé ou validé avant fabrication.
							</small>

						</div>

					</div>


					<div class="col-lg-6 col-md-6">

						<div class="form-group">

							{{ form_row(detail.productionNecessaire, {
                    label: 'Passage en production',
                    attr: {
                        class: 'js-production-necessaire'
                    }
                }) }}

							<small class="form-text text-muted">
								Désactivez cette option pour une vente directe :
																																																																																								                    papier, encre, consommable, support, etc.
							</small>

						</div>

					</div>

				</div>


				<div class="alert alert-info js-message-circuit mb-0">

					<i class="fa fa-info-circle mr-1"></i>

					<span class="js-message-circuit-texte">
						Circuit de traitement de cette ligne.
					</span>

				</div>

			</div>
			<div class="row">
				<div class="col-12 mb-3">
					<div class="form-group">
						{{ form_label(
                    detail.modeConfiguration,
                    'Mode de configuration'
                ) }}

						<div class="js-mode-configuration">
							{{ form_widget(detail.modeConfiguration) }}
						</div>

						{{ form_errors(detail.modeConfiguration) }}

						<small class="form-text text-muted js-aide-mode">
							Automatique : les informations et le prix viennent du catalogue.
																																																																																																																																																																																																																																																																																																						    Manuel : choisissez le produit et saisissez ses caractéristiques.
																																																																																																																																																																																																																																																																																																						    Libre : saisissez directement la désignation, la quantité et le prix.
						</small>
					</div>
				</div>


				<div class="col-lg-8 col-md-6">
					{{ form_row(detail.designation, {
                label: 'Désignation du travail',
                attr: {
                    class: 'form-control',
                    placeholder: 'Ex. Bâche publicitaire 3 × 2 m'
                }
            }) }}
				</div>

				<div class="col-lg-8 col-md-6 js-zone-configuration-automatique">
					{{ form_row(detail.produitConfiguration, {
                label: 'Configuration du produit',
                attr: {
                    class: 'form-control js-select-search',
                    'data-detail-field': 'configuration',
                    'data-placeholder': 'Rechercher une configuration...'
                }
            }) }}

					<small class="form-text text-muted">
						Le type d’impression, le support, le format et le prix
																																																																																																																																																																																																																																																																																																																																																																																																																																																					                seront récupérés automatiquement.
					</small>
				</div>


				<div class="col-12 js-zone-champs-configuration">
					<div class="row">
						<div class="col-lg-4 col-md-6">
							{{ form_row(detail.typeImpression, {
                        label: "Type d’impression",
                        attr: {
                            class: 'form-control js-select-search',
                            'data-detail-field': 'typeImpression',
                            'data-placeholder': "Rechercher un type d’impression..."
                        }
                    }) }}
						</div>

						<div class="col-lg-4 col-md-6">
							{{ form_row(detail.support, {
                        label: "Support d’impression",
                        attr: {
                            class: 'form-control js-select-search',
                            'data-detail-field': 'support',
                            'data-placeholder': "Rechercher un support..."
                        }
                    }) }}
						</div>

						<div class="col-lg-4 col-md-6">
							{{ form_row(detail.format, {
                        label: 'Format',
                        attr: {
                            class: 'form-control js-select-search',
                            'data-detail-field': 'format',
                            'data-placeholder': 'Rechercher un format...'
                        }
                    }) }}
						</div>
					</div>

					<small class="form-text text-muted js-message-champs-auto">
						Ces champs proviennent de la configuration sélectionnée.
					</small>
				</div>
			</div>
		</div>

		<div class="travail-section">
			<div class="travail-section-title">
				<i class="fa fa-arrows-alt"></i>
				Dimensions, quantité et prix
			</div>
			<div class="row">
				<div class="col-lg-3 col-md-6 js-zone-largeur">
					{{ form_row(detail.largeur, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'largeur',
            min: 0,
            step: '0.01'
        }
    }) }}
				</div>

				<div class="col-lg-3 col-md-6 js-zone-longueur">
					{{ form_row(detail.longueur, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'longueur',
            min: 0,
            step: '0.01'
        }
    }) }}
				</div>

				<div class="col-lg-3 col-md-6 js-zone-surface">
					{{ form_row(detail.surface, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'surface',
            readonly: true
        }
    }) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.quantite, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'quantite',
            min: 1
        }
    }) }}
					<small class="form-text text-muted js-message-quantite"></small>
				</div>
				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.nombreFaces, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'nombreFaces',
            min: 1
        }
    }) }}
				</div>
				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.modeCalcul, {
        label: 'Mode de calcul',
        attr: {
            class: 'form-control js-mode-calcul js-calcul-detail',
            'data-detail-field': 'modeCalcul'
        }
    }) }}
				</div>
				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.prixUnitaire, {
        label: 'Prix unitaire',
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'prixUnitaire',
            min: 0
        }
    }) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.remise, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'remise',
            min: 0,
            max: 100
        }
    }) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.tva, {
        attr: {
            class: 'form-control js-calcul-detail',
            'data-detail-field': 'tva',
            min: 0
        }
    }) }}
				</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.totalHt) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.totalTtc) }}</div>
			</div>
		</div>
		<div class="travail-section">
			<div class="travail-section-title">
				<i class="fa fa-magic"></i>
				Finitions
			</div>

			{# Finitions provenant de ProduitConfiguration #}
			<div class="js-zone-finitions-automatiques">
				<div class="finitions-box js-finitions-box" data-input-name="{{ detail.finitionsSelectionnees.vars.full_name }}">
					{{ form_widget(detail.finitionsSelectionnees) }}
					{{ form_errors(detail.finitionsSelectionnees) }}
				</div>

				<small class="form-text text-muted">
					Les finitions disponibles proviennent de la configuration.
																																																																																																																																																																																									            Les finitions obligatoires sont automatiquement sélectionnées.
				</small>
			</div>

			{# Finitions saisies en modes manuel et libre #}
			<div class="js-zone-finitions-manuelles" data-index="{{ detail.finitions|length }}" data-prototype="{{ _self.finition_manuelle( detail.finitions.vars.prototype )|e('html_attr') }}" style="display: none;">
				<div class="js-liste-finitions-manuelles">
					{% for finition in detail.finitions %}
						{{ _self.finition_manuelle(finition) }}
					{% endfor %}
				</div>

				{{ form_errors(detail.finitions) }}

				<button type="button" class="btn btn-primary-light btn-sm js-ajouter-finition">
					<i class="fa fa-plus mr-1"></i>
					Ajouter une finition
				</button>

				<small class="form-text text-muted d-block mt-2">
					Choisissez la finition, son prix, son mode de calcul
																																																																																																																																																																																									            et sa quantité.
				</small>
			</div>
		</div>

		<div class="travail-section">
			<div class="travail-section-title">
				<i class="fa fa-sliders"></i>
				Caractéristiques techniques
			</div>
			<div class="row">
				<div class="col-lg-3 col-md-6">{{ form_row(detail.profilCouleurs) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.resolution) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.grammage) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.epaisseur) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.laminage) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.pliage) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.priorite) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.tempsEstime) }}</div>
				<div class="col-lg-3 col-md-6">{{ form_row(detail.tempsReel) }}</div>
			</div>
			<div class="row">
				<div class="col-md-3">{{ form_row(detail.rectoVerso) }}</div>
				<div class="col-md-3">{{ form_row(detail.oeillets) }}</div>
				<div class="col-md-3">{{ form_row(detail.decoupe) }}</div>
				<div class="col-md-3">{{ form_row(detail.emballage) }}</div>
				<div class="col-md-3">{{ form_row(detail.batValide) }}</div>
				<div class="col-md-3">{{ form_row(detail.etat) }}</div>
			</div>
			{{ form_row(detail.observation) }}
		</div>

		<div class="travail-section">
			<div class="travail-section-title">
				<i class="fa fa-cloud-upload"></i>
				Fichiers du client
			</div>
			{{ form_widget(detail.jetonsFichiers, {
				attr: {
					class: 'js-jetons-fichiers'
				}
			}) }}
			<input type="file" class="form-control js-fichiers-client" multiple accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.svg,.ai,.eps,.psd,.cdr">
			<small class="form-text text-muted">
				Les fichiers volumineux sont envoyés automatiquement par morceaux.
			</small>
			<div class="js-liste-uploads mt-3"></div>
		</div>
	</div>
{% endmacro %}
{% set jetonTemporaire =
    'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
%}

{% set indexTemporaire = 999999999 %}

{% set modeleUrlMorceau = path(
    'app_fichier_upload_morceau',
    {
        jeton: jetonTemporaire,
        index: indexTemporaire
    }
) %}

{% set modeleUrlMorceau = modeleUrlMorceau|replace({
    (jetonTemporaire): '__JETON__',
    (indexTemporaire ~ ''): '__INDEX__'
}) %}

{% set modeleUrlStatut = path(
    'app_fichier_upload_statut',
    {
        jeton: jetonTemporaire
    }
) %}

{% set modeleUrlStatut = modeleUrlStatut|replace({
    (jetonTemporaire): '__JETON__'
}) %}

{{ form_start(form, {
    attr: {
        id: 'commande-form',
        enctype: 'multipart/form-data',

        'data-upload-csrf': csrf_token(
            'upload-commande'
        ),

        'data-upload-initialiser-url': path(
            'app_fichier_upload_initialiser'
        ),

        'data-upload-morceau-url': modeleUrlMorceau,

        'data-upload-statut-url': modeleUrlStatut
    }
}) }}

<div class="side-app">
	<div class="page-header">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="{{ path('app_commandes_index') }}">Commandes</a>
			</li>
			<li class="breadcrumb-item active" aria-current="page">
				{{ form.vars.data.id ? 'Modifier la commande' : 'Nouvelle commande' }}
			</li>
		</ol>
		<a href="{{ path('app_commandes_index') }}" class="btn btn-sm btn-primary-light">
			<i class="fa fa-list mr-1"></i>
			Liste des commandes
		</a>
	</div>

	{% if not form.vars.valid %}
		<div class="alert alert-danger">
			{{ form_errors(form) }}
		</div>
	{% endif %}

	<div class="row">
		<div class="col-xl-12">
			<div class="card">
				<div class="card-header">
					<div class="card-title">
						<i class="fa fa-user-circle mr-2 text-primary"></i>
						Client et responsable
					</div>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-lg-6">
							{{ form_row(form.clients, {
                                label: 'Client',
                                attr: {
                                    class: 'form-control js-select-search',
                                    'data-placeholder': 'Rechercher un client...'
                                }
                            }) }}
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-xl-12">
			<div class="card">
				<div class="card-header">
					<div class="card-title">
						<i class="fa fa-file-text-o mr-2 text-primary"></i>
						Informations de la commande
					</div>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-6 col-xl-3">
							<input type="text" class="form-control" value="{{ form.vars.data.numero|default('Généré automatiquement') }}" disabled>
						</div>


						<div class="col-md-6 col-xl-3">
							{{ form_row(form.statut, {
                                label: 'Statut',
                                attr: { class: 'form-control' }
                            }) }}
						</div>
						<div class="col-md-6 col-xl-3">
							{{ form_row(form.etat, {
                                label: 'État',
                                attr: { class: 'form-control' }
                            }) }}
						</div>
						<div class="col-md-6 col-xl-3">
							{{ form_row(form.tva, {
                                label: 'TVA (%)',
                                attr: { class: 'form-control', min: 0 }
                            }) }}
						</div>
						<div class="col-md-12 col-xl-6">
							{{ form_row(form.observation, {
                                label: 'Observation',
                                attr: {
                                    class: 'form-control',
                                    rows: 3,
                                    placeholder: 'Informations complémentaires...'
                                }
                            }) }}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-xl-12">
			<div class="card cart">
				<div class="card-header d-flex justify-content-between align-items-center">
					<div>
						<div class="card-title mb-0">
							<i class="fa fa-shopping-cart mr-2 text-primary"></i>
							Produits et prestations
						</div>

						<small class="text-muted">
							Ajoutez des travaux d’impression, des prestations
																																																	    ou des produits vendus directement.
						</small>
					</div>
					<button type="button" id="add-detail" class="btn btn-success-light">
						<i class="fa fa-plus mr-1"></i>
						Ajouter un détail
					</button>
				</div>

				<div class="card-body">
					{{ form_errors(form.commandesDetails) }}

					<div id="collection-details" data-index="{{ form.commandesDetails|length }}" data-prototype="{{ _self.champs_detail(form.commandesDetails.vars.prototype)|e('html_attr') }}">
						{% for detail in form.commandesDetails %}
							<div class="detail-commande card border mb-4">
								<div class="card-header bg-light d-flex justify-content-between align-items-center">
									<div class="card-title detail-title mb-0">
										Travail
										{{ loop.index }}
									</div>
									<button type="button" class="btn btn-danger-light btn-sm supprimer-detail">
										<i class="icon icon-trash mr-1"></i>
										Supprimer
									</button>
								</div>
								<div class="card-body p-0">
									{{ _self.champs_detail(detail) }}
								</div>
							</div>
						{% else %}
							<div id="aucun-detail" class="alert alert-info mb-0">
								Aucun travail ajouté. Cliquez sur « Ajouter un détail ».
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-xl-5 ml-auto">
			<div class="card">
				<div class="card-header">
					<div class="card-title">
						<i class="fa fa-calculator mr-2 text-primary"></i>
						Récapitulatif
					</div>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							{{ form_row(form.totalHt, {
                                label: 'Total HT',
                                attr: { class: 'form-control montant-calcul', readonly: true }
                            }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(form.remise, {
                                label: 'Remise',
                                attr: { class: 'form-control', min: 0 }
                            }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(form.totalTtc, {
                                label: 'Total TTC',
                                attr: { class: 'form-control montant-calcul', readonly: true }
                            }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(form.montantApayer, {
                                label: 'Montant à payer',
                                attr: { class: 'form-control montant-calcul', readonly: true }
                            }) }}
						</div>
					</div>
				</div>
				<div class="card-footer d-flex justify-content-between">
					<a href="{{ path('app_commandes_index') }}" class="btn btn-primary-light">
						<i class="fa fa-arrow-left mr-1"></i>
						Annuler
					</a>
					<button type="submit" class="btn btn-success-light">
						<i class="fa fa-save mr-1"></i>
						{{ button_label|default('Enregistrer la commande') }}
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

