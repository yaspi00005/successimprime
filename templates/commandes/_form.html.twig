<link href="{{ asset('assets/plugins/select2/select2.min.css') }}" rel="stylesheet"> <style>
	/*
 * Le thème Arox applique parfois une couleur blanche aux champs.
 * On force ici une couleur lisible dans tout le formulaire commande.
 */
	#commande-form input.form-control,
	#commande-form select.form-control,
	#commande-form textarea.form-control {
		color: #1f2937 !important;
		-webkit-text-fill-color: #1f2937;
		background-color: #fff !important;
	}

	#commande-form select.form-control option {
		color: #1f2937;
		background-color: #fff;
	}

	#commande-form .select2-container {
		width: 100% !important;
	}

	#commande-form .select2-container .select2-selection--single {
		height: 40px;
		color: #1f2937;
		border: 1px solid #d8deea;
		border-radius: 5px;
		background: #fff;
	}

	#commande-form .select2-container .select2-selection--single .select2-selection__rendered {
		line-height: 38px;
		color: #1f2937 !important;
		padding-left: 12px;
	}

	#commande-form .select2-container .select2-selection--single .select2-selection__arrow {
		height: 38px;
	}

	.select2-dropdown,
	.select2-results__option,
	.select2-search__field {
		color: #1f2937 !important;
