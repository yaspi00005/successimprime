} else {
chargerOptionsManuelles(detail);
}
}
}


/*
         * ====================================================
         * ARTICLE AJAX
         * ====================================================
         */

async function chargerArticle(detail) {
if (valeurTypeLigne(detail) !== 'article') {
return;
}

const select = champDetail(detail, 'article');

const message = detail.querySelector('.js-stock-article');

if (! select || ! select.value) {

if (message) {
message.textContent = 'Sélectionnez un article.';
}

return;
}


if (message) {
message.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Chargement...';
}


try {

const response = await fetch(construireUrl(articleCommandeUrl, select.value), {
headers: {
Accept: 'application/json'
}
});

const json = await response.json();

if (! response.ok || ! json.success) {
throw new Error(json.message || 'Impossible de charger l’article.');
}


const article = json.article;
/*
 * ====================================================
 * DÉSIGNATION AUTOMATIQUE POUR ARTICLE EN STOCK
 * ====================================================
 */
const designationChamp = champDetail(detail, 'designation');

if (designationChamp) {
designationChamp.value = article.designation || '';

/*
     * Pour une vente d'article stock,
     * la désignation vient directement de l'article.
     */
designationChamp.readOnly = true;

designationChamp.dispatchEvent(new Event('input', {bubbles: true}));
}

definirValeur(detail, 'designation', article.designation);

definirValeur(detail, 'prixUnitaire', article.prixVente || 0);

definirValeur(detail, 'modeCalcul', 'unite');


detail.dataset.articleStockDisponible = String(article.stockDisponible || 0);

detail.dataset.articleUnite = article.unite || '';


if (message) {

const disponible = Number(article.stockDisponible || 0);

message.innerHTML = '<strong>' + (
article.reference || ''
) + '</strong><br>' + 'Physique : ' + formaterNombre(article.stockPhysique) + ' ' + (
article.unite || ''
) + '<br>' + 'Réservé : ' + formaterNombre(article.stockReserve) + ' ' + (
article.unite || ''
) + '<br>' + '<strong class="' + (
disponible > 0 ? 'text-success' : 'text-danger'
) + '">' + 'Disponible : ' + formaterNombre(disponible) + ' ' + (
article.unite || ''
) + '</strong><br>' + 'Prix : ' + formaterMontant(article.prixVente) + ' FCFA';
}


calculerDetail(detail);

} catch (e) {

console.error(e);

if (message) {
message.innerHTML = '<span class="text-danger">' + e.message + '</span>';
}
}
}


/*
         * ====================================================
         * PRODUIT / CONFIG AJAX
         * ====================================================
         */

async function chargerConfigurationsProduit(detail) {
const produit = champDetail(detail, 'produit');

const configuration = champDetail(detail, 'configuration');

console.log('[DEBUG] chargerConfigurationsProduit() appelee, produit.value =', produit ? produit.value : '(champ produit introuvable)', 'configuration champ trouve ?', !! configuration);

if (! produit || ! configuration) {
console.log('[DEBUG] chargerConfigurationsProduit() : champ produit ou configuration introuvable, arret');
return;
}


configuration.innerHTML = '<option value="">Sélectionnez une configuration</option>';


if (! produit.value) {
console.log('[DEBUG] chargerConfigurationsProduit() : aucun produit selectionne, arret');
return;
}


try {

const url = construireUrl(configurationsProduitUrl, produit.value);
console.log('[DEBUG] chargerConfigurationsProduit() : fetch vers', url);

const response = await fetch(url);

console.log('[DEBUG] chargerConfigurationsProduit() : reponse HTTP', response.status);

const json = await response.json();

console.log('[DEBUG] chargerConfigurationsProduit() : JSON recu', json);

const configs = Array.isArray(json) ? json : (json.configurations || json.data || []);

console.log('[DEBUG] chargerConfigurationsProduit() : nombre de configurations =', configs.length);


configs.forEach(function (config) {
const option = document.createElement('option');

option.value = config.id;

option.textContent = config.libelle || config.nom || ('Configuration ' + config.id);

configuration.appendChild(option);
});


if (configs.length === 1) {
configuration.value = configs[0].id;

await chargerConfiguration(detail);
}


} catch (e) {

console.error(e);
}
}


/*
         * ====================================================
         * PRODUIT MANUEL AJAX
         * ====================================================
         */

function filtrerOptions(select, idsAutorises) {
if (! select) {
return;
}

const autorises = new Set((idsAutorises || []).map(String));

let valeurEncoreValide = false;

Array.from(select.options).forEach(function (option) {
if (! option.value) {
return;
}

const visible = autorises.has(String(option.value));

option.hidden = ! visible;

option.disabled = ! visible;

if (visible && option.value === select.value) {
valeurEncoreValide = true;
}
});

if (! valeurEncoreValide) {
select.value = '';
}

if (window.jQuery && window.jQuery.fn.select2 && window.jQuery(select).hasClass('select2-hidden-accessible')) {
window.jQuery(select).trigger('change.select2');
}
}


/*
 * Applique la liste de finitions autorisees (memorisee par
 * chargerOptionsManuelles() dans detail.dataset.finitionsAutorisees)
 * a toutes les lignes de finition manuelle deja presentes.
 */
function appliquerFiltreFinitions(detail) {
if (detail.dataset.finitionsAutorisees === undefined) {
return;
}

const ids = detail.dataset.finitionsAutorisees === '' ? [] : detail.dataset.finitionsAutorisees.split(',');

detail.querySelectorAll('.js-finition-manuelle select.js-select-search').forEach(function (select) {
filtrerOptions(select, ids);
});
}


async function chargerOptionsManuelles(detail) {
if (valeurTypeLigne(detail) !== 'produit' || valeurModeConfiguration(detail) !== 'manuel') {
return;
}

const produit = champDetail(detail, 'produit');

if (! produit || ! produit.value) {
return;
}


try {

const response = await fetch(construireUrl(optionsManuellesUrl, produit.value));

const json = await response.json();

if (! response.ok || ! json.success) {
throw new Error(json.message || 'Impossible de charger le produit.');
}

const infosProduit = json.produit || {};


definirValeur(detail, 'prixUnitaire', infosProduit.prixBase || 0);

definirValeur(detail, 'remise', clientEstB2B() ? Math.round(infosProduit.remiseB2B || 0) : 0);

definirValeur(detail, 'modeCalcul', infosProduit.modeCalcul || 'unite');


filtrerOptions(champDetail(detail, 'typeImpression'), (json.typesImpression || []).map(function (t) {
return t.id;
}));

filtrerOptions(champDetail(detail, 'support'), (json.supports || []).map(function (s) {
return s.id;
}));

filtrerOptions(champDetail(detail, 'format'), (json.formats || []).map(function (f) {
return f.id;
}));

/*
 * Finitions compatibles avec le produit : memorisees sur le
 * detail pour filtrer aussi bien les lignes de finition deja
 * presentes que celles ajoutees plus tard via "Ajouter une
 * finition" (voir appliquerFiltreFinitions() et l'ecouteur de
 * .js-ajouter-finition dans initialiserDetail()).
 */
detail.dataset.finitionsAutorisees = (json.finitions || []).map(function (f) {
return f.id;
}).join(',');

appliquerFiltreFinitions(detail);


calculerDetail(detail);


} catch (e) {

console.error(e);
}
}


async function chargerConfiguration(detail) {
const configuration = champDetail(detail, 'configuration');

console.log('[DEBUG] chargerConfiguration() appelee, configuration.value =', configuration ? configuration.value : '(champ configuration introuvable)');

if (! configuration || ! configuration.value) {
console.log('[DEBUG] chargerConfiguration() : pas de configuration selectionnee, arret');
return;
}


try {

const url = construireUrl(configurationUrl, configuration.value);
console.log('[DEBUG] chargerConfiguration() : fetch vers', url);

const response = await fetch(url);

console.log('[DEBUG] chargerConfiguration() : reponse HTTP', response.status);

const json = await response.json();

console.log('[DEBUG] chargerConfiguration() : JSON recu', json);

const config = json.configuration || json.data || json;


definirValeur(detail, 'typeImpression', config.typeImpression);

definirValeur(detail, 'support', config.support);

definirValeur(detail, 'format', config.format);

definirValeur(detail, 'prixUnitaire', config.prixBase || 0);

definirValeur(detail, 'remise', clientEstB2B() ? Math.round(config.remiseB2B || 0) : 0);

definirValeur(detail, 'modeCalcul', config.modeCalcul || 'unite');


const finitionsBox = detail.querySelector('.js-finitions-box');

if (finitionsBox) {

const nomChamp = finitionsBox.dataset.inputName;

finitionsBox.innerHTML = '';

(config.finitions || []).forEach(function (finition, index) {
const ligne = document.createElement('div');

ligne.className = 'form-check form-check-inline';

const checkbox = document.createElement('input');

checkbox.type = 'checkbox';

checkbox.className = 'form-check-input js-finition-selectionnee';

checkbox.name = nomChamp + '[]';

checkbox.value = finition.id;

checkbox.dataset.prix = finition.prix || 0;

checkbox.checked = Boolean(finition.obligatoire || finition.selectionneeParDefaut);


const label = document.createElement('label');

label.className = 'form-check-label';

label.textContent = finition.nom || 'Finition';


ligne.appendChild(checkbox);

ligne.appendChild(label);

finitionsBox.appendChild(ligne);
});
}


calculerDetail(detail);


} catch (e) {

console.error(e);
}
}


/*
         * ====================================================
         * VERROUILLAGE
         * ====================================================
         */

function verrouiller(detail) {
if (! commandeVerrouillee) {
return;
}

detail.querySelectorAll('input:not([type="hidden"]), textarea').forEach(function (input) {
if (input.type !== 'file' && input.type !== 'checkbox' && input.type !== 'radio') {
input.readOnly = true;
}
});


detail.querySelectorAll('select').forEach(function (select) {
select.style.pointerEvents = 'none';
});
}


/*
         * ====================================================
         * INITIALISATION DÉTAIL
         * ====================================================
         */

function initialiserDetail(detail) {
const travail = detail.querySelector('.js-commande-detail') || detail;


initialiserSelect2(travail);


if (commandeVerrouillee) {

verrouiller(travail);

return;
}


/*
             * TYPE
             */
travail.querySelectorAll('[name$="[typeLigne]"]').forEach(function (input) {
input.addEventListener('change', function () {
appliquerTypeLigne(travail);
});
});


/*
             * MODE CONFIG
             */
travail.querySelectorAll('[name$="[modeConfiguration]"]').forEach(function (input) {
input.addEventListener('change', function () {
appliquerModeConfiguration(travail);
});
});


/*
             * ARTICLE
             */
const article = champDetail(travail, 'article');

if (article) {

article.addEventListener('change', function () {
chargerArticle(travail);
});

if (article.value && valeurTypeLigne(travail) === 'article') {
chargerArticle(travail);
}
}


/*
             * PRODUIT
             */
const produit = champDetail(travail, 'produit');

console.log('[DEBUG] initialiserDetail() : champ produit trouve ?', !! produit);

if (produit) {

produit.addEventListener('change', function () {
console.log('[DEBUG] changement produit DETECTE, valeur =', produit.value, 'mode =', valeurModeConfiguration(travail));

if (valeurModeConfiguration(travail) === 'manuel') {
chargerOptionsManuelles(travail);
} else {
chargerConfigurationsProduit(travail);
}
});
}


/*
             * CONFIG
             */
const configuration = champDetail(travail, 'configuration');

if (configuration) {

configuration.addEventListener('change', function () {
chargerConfiguration(travail);
});
}


/*
             * FINITIONS MANUELLES
             *
             * "Ajouter une finition"/"Supprimer" n'avaient aucun
             * gestionnaire : les boutons ne faisaient rien.
             */
const zoneFinitionsManuelles = travail.querySelector('.js-zone-finitions-manuelles');

if (zoneFinitionsManuelles) {

const boutonAjouterFinition = zoneFinitionsManuelles.querySelector('.js-ajouter-finition');
const listeFinitions = zoneFinitionsManuelles.querySelector('.js-liste-finitions-manuelles');

function initialiserLigneFinition(ligne) {
initialiserSelect2(ligne);

const select = ligne.querySelector('select.js-select-search');

if (select && travail.dataset.finitionsAutorisees !== undefined) {
const ids = travail.dataset.finitionsAutorisees === '' ? [] : travail.dataset.finitionsAutorisees.split(',');

filtrerOptions(select, ids);
}

const supprimer = ligne.querySelector('.js-supprimer-finition');

if (supprimer) {
supprimer.addEventListener('click', function () {
ligne.remove();
calculerDetail(travail);
});
}
}

if (boutonAjouterFinition && listeFinitions) {
boutonAjouterFinition.addEventListener('click', function () {
const index = Number(zoneFinitionsManuelles.dataset.index || 0);
const html = zoneFinitionsManuelles.dataset.prototype.replace(/__finition_index__/g, String(index));

zoneFinitionsManuelles.dataset.index = String(index + 1);

const temporaire = document.createElement('div');
temporaire.innerHTML = html.trim();
const nouvelleLigne = temporaire.firstElementChild;

if (nouvelleLigne) {
listeFinitions.appendChild(nouvelleLigne);
initialiserLigneFinition(nouvelleLigne);
calculerDetail(travail);
}
});
}

listeFinitions ?. querySelectorAll('.js-finition-manuelle').forEach(initialiserLigneFinition);
}


/*
             * CALCULS
             */
function declencheCalcul(cible) {
return Boolean(cible.closest('.js-calcul-detail') || cible.classList.contains('js-finition-selectionnee') || cible.closest('.js-finition-manuelle'));
}

travail.addEventListener('input', function (event) {
if (declencheCalcul(event.target)) {
calculerDetail(travail);
}
});


travail.addEventListener('change', function (event) {
if (declencheCalcul(event.target)) {
calculerDetail(travail);
}
});


/*
             * CIRCUIT
             */
travail.querySelectorAll('.js-prepresse-necessaire, .js-production-necessaire').forEach(function (input) {
input.addEventListener('change', function () {
appliquerCircuit(travail);
});
});


/*
             * SUPPRESSION
             */
const supprimer = detail.querySelector('.supprimer-detail');

if (supprimer) {

supprimer.addEventListener('click', function () {
detail.remove();

rafraichirDetails();
});
}


appliquerTypeLigne(travail);

appliquerCircuit(travail);

calculerDetail(travail);
}


/*
         * ====================================================
         * AJOUT DÉTAIL
         * ====================================================
         */

function ajouterDetail() {

if (commandeVerrouillee) {
return;
}


const prototype = collection.dataset.prototype;

if (! prototype) {

console.error('Prototype détail absent.');

return;
}


const index = Number(collection.dataset.index || 0);


const html = prototype.replace(/__detail__/g, String(index)).replace(/__name__/g, String(index));


collection.dataset.index = String(index + 1);


const wrapper = document.createElement('div');

wrapper.className = 'detail-commande card border mb-4';


wrapper.innerHTML = `
                <div class="card-header bg-light d-flex justify-content-between align-items-center">

                    <div class="card-title detail-title mb-0">
                        Nouveau travail
                    </div>

                    <button
                        type="button"
                        class="btn btn-danger-light btn-sm supprimer-detail"
                    >
                        <i class="fa fa-trash mr-1"></i>
                        Supprimer
                    </button>

                </div>

                <div class="card-body p-0">
                    ${html}
                </div>
                `;


collection.appendChild(wrapper);


initialiserDetail(wrapper);


rafraichirDetails();
}


function rafraichirDetails() {

const details = collection.querySelectorAll('.detail-commande');

details.forEach(function (detail, index) {
const titre = detail.querySelector('.detail-title');

if (titre) {
titre.textContent = 'Travail ' + (
index + 1
);
}
});


const vide = document.getElementById('aucun-detail');

if (vide) {
vide.style.display = details.length ? 'none' : '';
}


calculerCommande();
}


/*
         * ====================================================
         * BIND GLOBAL
         * ====================================================
         */

if (addButton && ! commandeVerrouillee) {
addButton.addEventListener('click', ajouterDetail);
}


console.log('[DEBUG] tentative attache ecouteur client, clientSelect=', !! clientSelect, 'commandeVerrouillee=', commandeVerrouillee);

if (clientSelect && ! commandeVerrouillee) {
clientSelect.addEventListener('change', appliquerNouveauProfilClient);
console.log('[DEBUG] ecouteur client ATTACHE');
} else {
console.log('[DEBUG] ecouteur client NON attache');
} collection.querySelectorAll('.detail-commande').forEach(initialiserDetail);


const remiseCommande = document.getElementById('{{ form.remise.vars.id }}');

if (remiseCommande) {

remiseCommande.addEventListener('input', calculerCommande);
}


initialiserSelect2(form);


afficherProfilClient();


rafraichirDetails();

});
</script>
