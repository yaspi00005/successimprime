collection.dataset.index = String(index + 1);

const detail = document.createElement('div');

detail.className = 'detail-commande js-commande-detail card border mb-4';

detail.innerHTML = `
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <div class="card-title detail-title mb-0">
                    Nouveau travail
                </div>

                <button
                    type="button"
                    class="btn btn-danger-light btn-sm supprimer-detail"
                >
                    <i class="icon icon-trash mr-1"></i>
                    Supprimer
                </button>
            </div>

            <div class="card-body p-0">${html}</div>
        `;

collection.appendChild(detail);

const produitSelect = detail.querySelector('[name$="[produit]"]');

const configurationSelect = detail.querySelector('[name$="[produitConfiguration]"]');

if (produitSelect) {
produitSelect.value = '';
}

if (configurationSelect) {
configurationSelect.innerHTML = '<option value="">Sélectionnez d’abord un produit</option>';

configurationSelect.value = '';
configurationSelect.disabled = true;
}

const quantite = champDetail(detail, 'quantite');

if (quantite && ! quantite.value) {
quantite.value = '1';
}

initialiserDetail(detail);
/*
 * Circuit par défaut :
 * prépresse + production.
 */
const prePresse = detail.querySelector('.js-prepresse-necessaire');

const production = detail.querySelector('.js-production-necessaire');

if (prePresse) {
prePresse.checked = true;
}

if (production) {
production.checked = true;
}
refreshDetails();
}

let soumissionApresUpload = false;
let preparationEnCours = false;

form.addEventListener('submit', async function (event) {
if (soumissionApresUpload) {
return;
}

event.preventDefault();

if (preparationEnCours) {
return;
}

const details = collection.querySelectorAll('.detail-commande');

if (details.length === 0) {
if (typeof Swal !== 'undefined') {
await Swal.fire({icon: 'warning', title: 'Détail obligatoire', text: 'Ajoutez au moins un détail avant d’enregistrer la commande.', confirmButtonText: 'D’accord'});
} else {
alert('Ajoutez au moins un détail avant d’enregistrer la commande.');
}

return;
}

if (! form.checkValidity()) {
form.reportValidity();
return;
}

const boutonSubmit = form.querySelector('button[type="submit"], input[type="submit"]');

preparationEnCours = true;

if (boutonSubmit) {
boutonSubmit.disabled = true;
}

try {
const champsFichiers = Array.from(form.querySelectorAll('.js-fichiers-client'));

for (const champFichiers of champsFichiers) {
const detail = champFichiers.closest('.js-commande-detail');

if (! detail) {
throw new Error('La ligne de travail associée au fichier est introuvable.');
}

const champJetons = detail.querySelector('.js-jetons-fichiers');
const liste = detail.querySelector('.js-liste-uploads');

if (! champJetons || ! liste) {
throw new Error('Les champs nécessaires à l’upload sont introuvables.');
}

const fichiers = Array.from(champFichiers.files || []);

if (fichiers.length === 0) {
continue;
}

liste.innerHTML = '';

for (const fichier of fichiers) {
await envoyerFichier(fichier, champJetons, liste);
}

/*
 * Les fichiers ont été envoyés séparément. Symfony recevra
 * uniquement les jetons confirmés par le serveur.
 */
champFichiers.value = '';
}

soumissionApresUpload = true;

if (boutonSubmit) {
boutonSubmit.disabled = false;
}

/*
 * Ne pas utiliser requestSubmit() ici : il déclenche une seconde fois
 * tous les gestionnaires "submit" de la page et l'un d'eux peut bloquer
 * l'envoi après un upload pourtant terminé.
 *
 * La validité HTML a déjà été contrôlée plus haut et tous les
 * fichiers ont reçu le statut TERMINE. On effectue donc maintenant une
 * seule soumission native vers Symfony avec les jetons cachés.
 */
preparationEnCours = false;
HTMLFormElement.prototype.submit.call(form);
} catch (erreur) {
console.error('Enregistrement interrompu :', erreur);

if (typeof Swal !== 'undefined') {
await Swal.fire({
icon: 'error',
title: 'Envoi impossible',
text: erreur.message || 'Le téléversement du fichier a échoué.'
});
} else {
alert(erreur.message || 'Le téléversement du fichier a échoué.');
} preparationEnCours = false;

if (boutonSubmit) {
boutonSubmit.disabled = false;
}
}
});

addButton.addEventListener('click', function (event) {
event.preventDefault();
addDetail();
});

const remiseCommande = document.getElementById('{{ form.remise.vars.id }}');

if (remiseCommande) {
remiseCommande.addEventListener('input', calculerRecapitulatif);
}

collection.querySelectorAll('.detail-commande').forEach(initialiserDetail);

loadSelect2();

/*
     * Le formulaire reste vide tant que l'utilisateur
     * n'a pas cliqué sur « Ajouter un détail ».
     */
refreshDetails();
});
function activerZone(zone, active) {
if (! zone) {
return;
}

zone.querySelectorAll('input, select, textarea').forEach(function (champ) {
champ.disabled = ! active;
});
}

function appliquerModeFinitions(detail) {
const mode = detail.querySelector('[name$="[modeConfiguration]"]') ?. value || 'automatique';

const zoneAutomatique = detail.querySelector('.js-zone-finitions-automatiques');

const zoneManuelle = detail.querySelector('.js-zone-finitions-manuelles');

activerZone(zoneAutomatique, mode === 'automatique');

activerZone(zoneManuelle, mode !== 'automatique');
}

function appliquerCircuitTraitement(detail) {
const prePresse = detail.querySelector('.js-prepresse-necessaire');

const production = detail.querySelector('.js-production-necessaire');

const message = detail.querySelector('.js-message-circuit-texte');

if (! prePresse || ! production) {
return;
}

const prePresseActif = prePresse.checked;

const productionActive = production.checked;

if (! prePresseActif && ! productionActive) {
if (message) {
message.textContent = 'Livraison directe : aucun passage en prépresse ni en production.';
}

return;
}

if (! prePresseActif && productionActive) {
if (message) {
message.textContent = 'Production directe : aucun passage en prépresse.';
}

return;
}

if (prePresseActif && productionActive) {
if (message) {
message.textContent = 'Circuit complet : prépresse, production puis livraison.';
}

return;
}

if (prePresseActif && ! productionActive) {
if (message) {
message.textContent = 'Prépresse puis livraison, sans passage en production.';
}
}
}


function bindCircuitTraitement(detail) {
if (detail.dataset.circuitBound === '1') {
appliquerCircuitTraitement(detail);
return;
}

detail.dataset.circuitBound = '1';

const prePresse = detail.querySelector('.js-prepresse-necessaire');

const production = detail.querySelector('.js-production-necessaire');

if (prePresse) {
prePresse.addEventListener('change', function () {
appliquerCircuitTraitement(detail);
});
}

if (production) {
production.addEventListener('change', function () {
appliquerCircuitTraitement(detail);
});
}

appliquerCircuitTraitement(detail);
}
</script>
