{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.commande-filter-card {
			position: sticky;
			top: 85px;
		}
		.commande-stat {
			border: 0;
			border-left: 4px solid #1643a3;
		}
		.commande-reference {
			font-weight: 700;
			color: #1643a3;
		}
		.commande-client {
			max-width: 230px;
			white-space: normal;
		}
		.commande-actions .btn {
			margin: 2px;
		}
		.filter-indicator {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 5px 10px;
			border-radius: 20px;
			background: #eef3ff;
			color: #1643a3;
			font-size: 12px;
			font-weight: 600;
		}
		.empty-state {
			padding: 55px 20px;
			text-align: center;
		}
		.empty-state i {
			font-size: 48px;
			color: #cbd3df;
		}
		@media(max-width: 1199px) {
			.commande-filter-card {
				position: static;
			}
		}
	</style>
{% endblock %}

{% block body %}
	{% set rechercheActive =
        app.request.query.get('q')
        or app.request.query.get('client')
        or app.request.query.get('statut')
        or app.request.query.get('etat')
        or app.request.query.get('paiement')
        or app.request.query.get('date_debut')
        or app.request.query.get('date_fin')
        or app.request.query.get('montant_min')
        or app.request.query.get('montant_max')
        or app.request.query.get('affichage') == 'toutes'
    %}

	<div class="side-app">
		<div class="page-header">
			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="{{ path('app_commandes_index') }}">Commandes</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Liste</li>
			</ol>

			<a href="{{ path('app_commandes_new') }}" class="btn btn-primary">
				<i class="fa fa-plus mr-1"></i>
				Nouvelle commande
			</a>
		</div>

		<div class="row">
			{% if is_granted('ROLE_ADMIN') %}

				<div class="col-sm-6 col-xl-3">
					<div class="card commande-stat">
						<div class="card-body">
							<div class="text-muted">
								Résultats affichés
							</div>

							<div class="h2 mb-0">
								{{ commandes|length }}
							</div>
						</div>
					</div>
				</div>


				<div class="col-sm-6 col-xl-3">
					<div class="card commande-stat border-warning">
						<div class="card-body">
							<div class="text-muted">
								À encaisser
							</div>

							<div class="h2 mb-0">
								{{
                        totalReste
                            |default(0)
                            |number_format(0, ',', ' ')
                    }}
								F CFA
							</div>
						</div>
					</div>
				</div>


				<div class="col-sm-6 col-xl-3">
					<div class="card commande-stat border-success">
						<div class="card-body">
							<div class="text-muted">
								Total encaissé
							</div>

							<div class="h2 mb-0">
								{{
                        totalPaye
                            |default(0)
                            |number_format(0, ',', ' ')
                    }}
								F CFA
							</div>
						</div>
					</div>
				</div>

			{% endif %}
			<div class="col-sm-6 col-xl-3">
				<div class="card commande-stat border-info">
					<div class="card-body">
						<div class="text-muted">Mode d’affichage</div>
						<div class="mt-2">
							{% if rechercheActive %}
								<span class="filter-indicator">
									<i class="fa fa-filter"></i>
									Recherche personnalisée
								</span>
							{% else %}
								<span class="filter-indicator">
									<i class="fa fa-bolt"></i>
									Commandes actives
								</span>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row row-cards">
			<div class="col-xl-3">
				<div class="card commande-filter-card">
					<div class="card-header">
						<div class="card-title">
							<i class="fa fa-filter mr-2"></i>Recherche avancée
						</div>
					</div>

					<form method="get" action="{{ path('app_commandes_index') }}">
						<div class="card-body">
							<div class="form-group">
								<label class="form-label">Recherche générale</label>
								<input type="search" name="q" class="form-control" value="{{ app.request.query.get('q') }}" placeholder="N° commande, client, téléphone…">
							</div>

							<div class="form-group">
								<label class="form-label">Client</label>
								<select name="client" class="form-control custom-select">
									<option value="">Tous les clients</option>
									{% for client in clients|default([]) %}
										<option value="{{ client.id }}" {{ app.request.query.get('client') == client.id ? 'selected' : '' }}>
											{{ client }}
										</option>
									{% endfor %}
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">Statut de paiement</label>
								<select name="statut" class="form-control custom-select">
									<option value="">Tous les statuts</option>
									{% for statut in statuts|default([]) %}
										<option value="{{ statut.id }}" {{ app.request.query.get('statut') == statut.id ? 'selected' : '' }}>
											{{ statut }}
										</option>
									{% endfor %}
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">État des travaux</label>
								<select name="etat" class="form-control custom-select">
									<option value="">Tous les états</option>
									{% for etat in etats|default([]) %}
										<option value="{{ etat.id }}" {{ app.request.query.get('etat') == etat.id ? 'selected' : '' }}>
											{{ etat }}
										</option>
									{% endfor %}
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">Situation financière</label>
								<select name="paiement" class="form-control custom-select">
									<option value="">Toutes</option>
									<option value="impayee" {{ app.request.query.get('paiement') == 'impayee' ? 'selected' : '' }}>
										Non payée
									</option>
									<option value="partielle" {{ app.request.query.get('paiement') == 'partielle' ? 'selected' : '' }}>
										Paiement partiel
									</option>
									<option value="payee" {{ app.request.query.get('paiement') == 'payee' ? 'selected' : '' }}>
										Entièrement payée
									</option>
								</select>
							</div>

							<div class="row">
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Du</label>
										<input type="date" name="date_debut" class="form-control" value="{{ app.request.query.get('date_debut') }}">
									</div>
								</div>
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Au</label>
										<input type="date" name="date_fin" class="form-control" value="{{ app.request.query.get('date_fin') }}">
									</div>
								</div>
							</div>

							<div class="row">
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Montant min.</label>
										<input type="number" min="0" name="montant_min" class="form-control" value="{{ app.request.query.get('montant_min') }}" placeholder="0">
									</div>
								</div>
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Montant max.</label>
										<input type="number" min="0" name="montant_max" class="form-control" value="{{ app.request.query.get('montant_max') }}" placeholder="Illimité">
									</div>
								</div>
							</div>

							<div class="form-group">
								<label class="form-label">Afficher</label>
								<select name="affichage" class="form-control custom-select">
									<option value="actives" {{ app.request.query.get('affichage', 'actives') == 'actives' ? 'selected' : '' }}>
										Commandes actives
									</option>
									<option value="toutes" {{ app.request.query.get('affichage') == 'toutes' ? 'selected' : '' }}>
										Toutes les commandes
									</option>
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">Trier par</label>
								<select name="tri" class="form-control custom-select">
									<option value="recent" {{ app.request.query.get('tri') == 'recent' ? 'selected' : '' }}>Plus récentes</option>
									<option value="ancien" {{ app.request.query.get('tri') == 'ancien' ? 'selected' : '' }}>Plus anciennes</option>
									<option value="montant_desc" {{ app.request.query.get('tri') == 'montant_desc' ? 'selected' : '' }}>Montant décroissant</option>
									<option value="reste_desc" {{ app.request.query.get('tri') == 'reste_desc' ? 'selected' : '' }}>Reste à payer décroissant</option>
								</select>
							</div>

							<button type="submit" class="btn btn-primary btn-block">
								<i class="fa fa-search mr-1"></i>
								Rechercher
							</button>

							<a href="{{ path('app_commandes_index') }}" class="btn btn-light btn-block">
								<i class="fa fa-refresh mr-1"></i>
								Réinitialiser
							</a>
						</div>
					</form>
				</div>
			</div>

			<div class="col-xl-9">
				<div class="card">
					<div class="card-header d-flex justify-content-between align-items-center">
						<div>
							<div class="card-title mb-1">Liste des commandes</div>
							<small class="text-muted">
								{% if rechercheActive %}
									Résultats correspondant à vos critères.
								{% else %}
									Affichage automatique : paiements en attente et travaux en cours.
								{% endif %}
							</small>
						</div>
					</div>

					<div class="table-responsive">
						<table class="table card-table table-vcenter text-nowrap">
							<thead>
								<tr>
									<th scope="col">Commande</th>
									<th scope="col">Client</th>
									<th scope="col">Travaux</th>
									<th scope="col">Paiement</th>
									<th scope="col" class="text-right">Total TTC</th>
									<th scope="col" class="text-right">Payé</th>
									<th scope="col" class="text-right">Reste à payer</th>
									<th scope="col" class="text-center">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for commande in commandes %}
									{% set total = commande.totalTtc|default(0) %}
									{% set paye = commande.totalPaye|default(0) %}
									{% set reste = commande.resteAPayer|default(0) %}
									{% set statutPaiement = commande.statutPaiement %}

									<tr>
										{# 1. Commande #}
										<td>
											<a href="{{ path('app_commandes_show', { id: commande.id }) }}" class="commande-reference">
												CMD-{{ '%05d'|format(commande.id) }}
											</a>

											<div class="small text-muted">
												#{{ commande.id }}
											</div>
										</td>

										{# 2. Client #}
										<td class="commande-client">
											<strong>
												{{ commande.clients }}
											</strong>
										</td>

										{# 3. Travaux #}
										<td>
											{% if commande.etat %}
												<span class="badge badge-info">
													En production
												</span>
											{% else %}
												<span class="badge badge-secondary">
													Terminée
												</span>
											{% endif %}

											<div class="small text-muted mt-1">
												{{ commande.commandesDetails|length }}
												travail{{ commande.commandesDetails|length > 1 ? 'x' : '' }}
											</div>
										</td>

										{# 4. Statut du paiement #}
										<td>
											{% if statutPaiement == 'payee' %}
												<span class="badge badge-success">
													<i class="fa fa-check-circle mr-1"></i>
													Payée
												</span>
											{% elseif statutPaiement == 'partielle' %}
												<span class="badge badge-warning">
													<i class="fa fa-clock-o mr-1"></i>
													Paiement partiel
												</span>
											{% else %}
												<span class="badge badge-danger">
													<i class="fa fa-times-circle mr-1"></i>
													Impayée
												</span>
											{% endif %}
										</td>

										{# 5. Total TTC #}
										<td class="text-right">
											<strong>
												{{ total|number_format(0, ',', ' ') }}
												FCFA
											</strong>
										</td>

										{# 6. Montant payé #}
										<td class="text-right text-success">
											<strong>
												{{ paye|number_format(0, ',', ' ') }}
												FCFA
											</strong>
										</td>

										{# 7. Reste à payer #}
										<td class="text-right">
											<strong class="{{ reste > 0 ? 'text-danger' : 'text-success' }}">
												{{ reste|number_format(0, ',', ' ') }}
												FCFA
											</strong>
										</td>

										{# 8. Actions #}
										<td class="text-center commande-actions">
											<a href="{{ path('app_commandes_show', { id: commande.id }) }}" class="btn btn-info-light btn-sm" title="Afficher">
												<i class="fa fa-eye"></i>
											</a>

											<a href="{{ path('app_commandes_edit', { id: commande.id }) }}" class="btn btn-primary-light btn-sm" title="Modifier">
												<i class="fa fa-pencil"></i>
											</a>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="8">
											<div class="empty-state">
												<i class="fa fa-inbox"></i>

												<h4 class="mt-3">
													Aucune commande trouvée
												</h4>

												<p class="text-muted">
													Modifiez les filtres ou réinitialisez la recherche.
												</p>

												<a href="{{ path('app_commandes_index') }}" class="btn btn-primary-light">
													Afficher les commandes actives
												</a>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{% if pagination is defined and pagination.pageCount > 1 %}
					<nav class="d-flex justify-content-end">
						<ul class="pagination">
							{% for page in 1..pagination.pageCount %}
								<li class="page-item {{ page == pagination.currentPage ? 'active' : '' }}">
									<a class="page-link" href="{{ path('app_commandes_index', app.request.query.all|merge({page: page})) }}">
										{{ page }}
									</a>
								</li>
							{% endfor %}
						</ul>
					</nav>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
document.querySelectorAll('[data-confirm]').forEach(function (button) {
button.addEventListener('click', function (event) {
event.preventDefault();
const url = button.getAttribute('href');

Swal.fire({
icon: 'warning',
title: 'Confirmer cette action ?',
text: button.dataset.confirm,
showCancelButton: true,
confirmButtonText: 'Oui, continuer',
cancelButtonText: 'Annuler'
}).then(function (result) {
if (result.isConfirmed) {
window.location.href = url;
}
});
});
});
});
	</script>
{% endblock %}
