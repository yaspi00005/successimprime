{% extends 'base.html.twig' %}

{% block title %}Tableau de bord
{% endblock %}

{% block stylesheets %}
	<style>
		.dashboard-kpi {
			border-radius: 12px;
			overflow: hidden;
		}

		.dashboard-kpi .card-body {
			padding: 1.5rem;
			display: flex;
			align-items: center;
			gap: 1rem;
		}

		.dashboard-kpi .kpi-valeur {
			font-size: 2rem;
			font-weight: 700;
			line-height: 1.1;
		}

		.dashboard-kpi .kpi-libelle {
			color: #8492a6;
			font-size: 0.85rem;
		}

		.dashboard-kpi .kpi-icone {
			width: 52px;
			height: 52px;
			min-width: 52px;
			border-radius: 12px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.4rem;
			color: #fff;
		}

		.kpi-icone-commandes { background: linear-gradient(135deg, #467fcf, #2c5aa0); }
		.kpi-icone-ca { background: linear-gradient(135deg, #5eba00, #3e8e00); }
		.kpi-icone-agent { background: linear-gradient(135deg, #f1c40f, #d4a90a); }
		.kpi-icone-clients { background: linear-gradient(135deg, #6f42c1, #59349b); }
		.kpi-icone-encaisse { background: linear-gradient(135deg, #5eba00, #2f7a00); }
		.kpi-icone-decaisse { background: linear-gradient(135deg, #cd201f, #921512); }
		.kpi-icone-reste { background: linear-gradient(135deg, #fd7e14, #c85f08); }

		.carte-evolution {
			background: linear-gradient(160deg, #1c2b45, #101a2c);
			border-radius: 12px;
			color: #e7ecf5;
		}

		.carte-evolution .card-header {
			border-bottom-color: rgba(255, 255, 255, 0.08);
		}

		.carte-evolution .card-title {
			color: #fff;
		}

		.carte-evolution .btn-group .btn {
			border-color: rgba(255, 255, 255, 0.15);
			color: #b9c4d6;
		}

		.carte-evolution .btn-group .btn.actif {
			background: #467fcf;
			border-color: #467fcf;
			color: #fff;
		}

		.agent-ligne {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 0.85rem 0;
			border-bottom: 1px solid #eef0f5;
		}

		.agent-ligne:last-child {
			border-bottom: none;
		}

		.agent-avatar {
			width: 42px;
			height: 42px;
			min-width: 42px;
			border-radius: 50%;
			object-fit: cover;
			background: #6366f1;
			color: #fff;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: 600;
		}

		.agent-barre-piste {
			background: #eef0f5;
			border-radius: 6px;
			height: 8px;
			overflow: hidden;
			margin-top: 0.35rem;
		}

		.agent-barre-remplie {
			height: 100%;
			border-radius: 6px;
			background: linear-gradient(90deg, #6366f1, #22c55e);
			width: 0;
			transition: width 1s ease;
		}

		.section-accueil-titre {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin: 1.75rem 0 0.75rem;
		}

		.section-accueil-titre h2 {
			font-size: 1.15rem;
			font-weight: 700;
			margin: 0;
		}
	</style>
{% endblock %}

{% block body %}

	<div class="side-app">

		<div class="page-header">

			<div>
				<h1 class="page-title">Tableau de bord</h1>
				<ol class="breadcrumb">
					<li class="breadcrumb-item active">Accueil</li>
				</ol>
			</div>

			<div class="ml-auto btn-group">
				{% for cle, libelle in {
					jour: 'Aujourd’hui',
					semaine: 'Cette semaine',
					mois: 'Ce mois',
					annee: 'Cette année',
					tout: 'Tout'
				} %}
					<a href="{{ path('app_home', {periode: cle, granularite: granulariteEvolution}) }}" class="btn btn-sm {{ periode == cle ? 'btn-primary' : 'btn-primary-light' }}">
						{{ libelle }}
					</a>
				{% endfor %}
			</div>

		</div>


		{# ==========================================================
		   KPI
		   ========================================================== #}

		<div class="row">

			<div class="col-lg-3 col-md-6 mb-3">
				<div class="card dashboard-kpi mb-0 h-100">
					<div class="card-body">
						<div class="kpi-icone kpi-icone-commandes">
							<i class="fa fa-shopping-cart"></i>
						</div>
						<div>
							<div class="kpi-valeur js-compteur" data-valeur="{{ totalCommandes }}">0</div>
							<div class="kpi-libelle">Commandes</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-3 col-md-6 mb-3">
				<div class="card dashboard-kpi mb-0 h-100">
					<div class="card-body">
						<div class="kpi-icone kpi-icone-ca">
							<i class="fa fa-money-bill"></i>
						</div>
						<div>
							<div class="kpi-valeur js-compteur" data-valeur="{{ totalCa }}" data-suffixe=" FCFA">0</div>
							<div class="kpi-libelle">Chiffre d'affaires</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-3 col-md-6 mb-3">
				<div class="card dashboard-kpi mb-0 h-100">
					<div class="card-body">
						<div class="kpi-icone kpi-icone-agent">
							<i class="fa fa-trophy"></i>
						</div>
						<div>
							<div class="kpi-valeur js-compteur" data-valeur="{{ meilleurCa }}" data-suffixe=" FCFA">0</div>
							<div class="kpi-libelle">Meilleur agent (CA)</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-3 col-md-6 mb-3">
				<div class="card dashboard-kpi mb-0 h-100">
					<div class="card-body">
						<div class="kpi-icone kpi-icone-clients">
							<i class="fa fa-users"></i>
						</div>
						<div>
							<div class="kpi-valeur js-compteur" data-valeur="{{ totalClients }}">0</div>
							<div class="kpi-libelle">Clients enregistrés</div>
						</div>
					</div>
				</div>
			</div>

		</div>

		{% if peutVoirStatsGlobales %}

			<div class="row">

				<div class="col-lg-4 col-md-6 mb-3">
					<div class="card dashboard-kpi mb-0 h-100">
						<div class="card-body">
							<div class="kpi-icone kpi-icone-encaisse">
								<i class="fa fa-arrow-down"></i>
							</div>
							<div>
								<div class="kpi-valeur js-compteur" data-valeur="{{ totalEncaisse }}" data-suffixe=" FCFA">0</div>
								<div class="kpi-libelle">Encaissé (période)</div>
							</div>
						</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6 mb-3">
					<div class="card dashboard-kpi mb-0 h-100">
						<div class="card-body">
							<div class="kpi-icone kpi-icone-decaisse">
								<i class="fa fa-arrow-up"></i>
							</div>
							<div>
								<div class="kpi-valeur js-compteur" data-valeur="{{ totalDecaisse }}" data-suffixe=" FCFA">0</div>
								<div class="kpi-libelle">Décaissé / charges (période)</div>
							</div>
						</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6 mb-3">
					<div class="card dashboard-kpi mb-0 h-100">
						<div class="card-body">
							<div class="kpi-icone kpi-icone-reste">
								<i class="fa fa-hourglass-half"></i>
							</div>
							<div>
								<div class="kpi-valeur js-compteur" data-valeur="{{ totalReste }}" data-suffixe=" FCFA">0</div>
								<div class="kpi-libelle">Reste à encaisser (impayés)</div>
							</div>
						</div>
					</div>
				</div>

			</div>

		{% endif %}


		{# ==========================================================
		   ÉVOLUTION
		   ========================================================== #}

		<div class="row">

			<div class="col-lg-6 mb-3">

				<div class="card carte-evolution mb-0 h-100">

					<div class="card-header d-flex align-items-center justify-content-between flex-wrap">

						<h3 class="card-title mb-0">
							Évolution du chiffre d'affaires
						</h3>

						<div class="btn-group">
							{% for cle, libelle in { jour: 'Jour', semaine: 'Semaine', mois: 'Mois', annee: 'Année' } %}
								<a href="{{ path('app_home', {periode: periode, granularite: cle}) }}" class="btn btn-sm {{ granulariteEvolution == cle ? 'actif' : '' }}">
									{{ libelle }}
								</a>
							{% endfor %}
						</div>

					</div>

					<div class="card-body">
						<canvas id="graphiqueEvolutionCa" height="220"></canvas>
					</div>

				</div>

			</div>

			<div class="col-lg-6 mb-3">

				<div class="card carte-evolution mb-0 h-100">

					<div class="card-header">
						<h3 class="card-title mb-0">
							Encaissements vs décaissements
						</h3>
					</div>

					<div class="card-body">
						<canvas id="graphiqueEncaissementsDecaissements" height="220"></canvas>
					</div>

				</div>

			</div>

		</div>


		{# ==========================================================
		   TOP AGENTS / CAISSIÈRES
		   ========================================================== #}

		<div class="row">

			<div class="col-lg-{{ peutVoirStatsGlobales ? 6 : 12 }} mb-3">

				<div class="card mb-0 h-100">

					<div class="card-header">
						<h3 class="card-title mb-0">
							Classement des agents (période sélectionnée)
						</h3>
					</div>

					<div class="card-body">

						{% for ligne in statsParAgent %}

							{% set pourcentage = meilleurCa > 0 ? (ligne.caGenere / meilleurCa * 100) : 0 %}

							<div class="agent-ligne">

								<div class="agent-avatar">
									{{ (ligne.agentPrenom|default(ligne.agentUsername)|slice(0, 1))|upper }}
								</div>

								<div class="flex-fill">

									<div class="d-flex justify-content-between">
										<strong>
											{{ ligne.agentPrenom is not empty ? (ligne.agentPrenom ~ ' ' ~ ligne.agentNom) : ligne.agentUsername }}
										</strong>
										<span class="text-muted">
											{{ ligne.nbCommandes }} commande(s) · {{ ligne.caGenere|number_format(0, ',', ' ') }} FCFA
										</span>
									</div>

									<div class="agent-barre-piste">
										<div class="agent-barre-remplie js-barre" data-largeur="{{ pourcentage }}"></div>
									</div>

								</div>

							</div>

						{% else %}

							<p class="text-muted text-center mb-0 py-4">
								Aucune commande sur cette période.
							</p>

						{% endfor %}

					</div>

				</div>

			</div>

			{% if peutVoirStatsGlobales %}

				<div class="col-lg-6 mb-3">

					<div class="card mb-0 h-100">

						<div class="card-header">
							<h3 class="card-title mb-0">
								Encaissements par caissière (période sélectionnée)
							</h3>
						</div>

						<div class="card-body">

							{% set meilleurCaissiere = parCaissiere is empty ? 0 : parCaissiere|map(l => l.montant)|sort|last %}

							{% for ligne in parCaissiere %}

								{% set pourcentageCaissiere = meilleurCaissiere > 0 ? (ligne.montant / meilleurCaissiere * 100) : 0 %}

								<div class="agent-ligne">

									<div class="agent-avatar" style="background: #5eba00;">
										{{ ligne.nom|slice(0, 1)|upper }}
									</div>

									<div class="flex-fill">

										<div class="d-flex justify-content-between">
											<strong>{{ ligne.nom }}</strong>
											<span class="text-muted">
												{{ ligne.nombre }} paiement(s) · {{ ligne.montant|number_format(0, ',', ' ') }} FCFA
											</span>
										</div>

										<div class="agent-barre-piste">
											<div class="agent-barre-remplie js-barre" data-largeur="{{ pourcentageCaissiere }}" style="background: linear-gradient(90deg, #5eba00, #2f7a00);"></div>
										</div>

									</div>

								</div>

							{% else %}

								<p class="text-muted text-center mb-0 py-4">
									Aucun encaissement sur cette période.
								</p>

							{% endfor %}

						</div>

					</div>

				</div>

			{% endif %}

		</div>


		{% if peutVoirStatsGlobales %}

			{# ==========================================================
			   COMMANDES NON SOLDÉES
			   ========================================================== #}

			<div class="section-accueil-titre">
				<h2><i class="fa fa-exclamation-circle mr-1"></i> Commandes non soldées</h2>
				<a href="{{ path('app_statistiques_commandes_index') }}" class="btn btn-sm btn-primary-light">Voir tout</a>
			</div>

			<div class="row">

				{% for tranche in parTranche %}
					<div class="col-lg-3 col-md-6 mb-3">
						<div class="card mb-0 h-100">
							<div class="card-body text-center">
								<small class="text-muted d-block">{{ tranche.libelle }}</small>
								<div class="h2 mb-0 {{ loop.index >= 3 ? 'text-danger' : (loop.index == 2 ? 'text-warning' : '') }}">
									{{ tranche.nombre }}
								</div>
								<small class="text-muted">{{ tranche.montant|number_format(0, ',', ' ') }} FCFA</small>
							</div>
						</div>
					</div>
				{% endfor %}

			</div>

			<div class="card">

				<div class="card-header">
					<h3 class="card-title">Les plus anciennes non soldées</h3>
					<div class="card-options">
						<strong>Total restant dû : {{ totalReste|number_format(0, ',', ' ') }} FCFA</strong>
					</div>
				</div>

				<div class="table-responsive">
					<table class="table table-bordered table-hover mb-0">
						<thead>
							<tr>
								<th>N° commande</th>
								<th>Client</th>
								<th>Date commande</th>
								<th class="text-right">Ancienneté</th>
								<th class="text-right">Reste à payer</th>
								<th width="80"></th>
							</tr>
						</thead>
						<tbody>
							{% for ligne in commandesNonSoldees %}
								<tr>
									<td>{{ ligne.commande.numero|default('#' ~ ligne.commande.id) }}</td>
									<td>{{ ligne.commande.clients ? ligne.commande.clients.nomComplet : 'Client supprimé' }}</td>
									<td>{{ ligne.commande.dateCommande|date('d/m/Y') }}</td>
									<td class="text-right">
										<span class="badge {{ ligne.jours > 90 ? 'badge-danger' : (ligne.jours > 30 ? 'badge-warning' : 'badge-light') }}">
											{{ ligne.jours }} jour(s)
										</span>
									</td>
									<td class="text-right">{{ ligne.reste|number_format(0, ',', ' ') }}</td>
									<td class="text-center">
										<a href="{{ path('app_commandes_show', {id: ligne.commande.id}) }}" class="btn btn-sm btn-primary-light" title="Voir la commande">
											<i class="fa fa-eye"></i>
										</a>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="6" class="text-center text-muted py-4">Toutes les commandes sont soldées.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

			</div>


			{# ==========================================================
			   TRÉSORERIE : CHARGES PAR CATÉGORIE
			   ========================================================== #}

			<div class="section-accueil-titre">
				<h2><i class="fa fa-wallet mr-1"></i> Trésorerie</h2>
				<a href="{{ path('app_statistiques_tresorerie_index') }}" class="btn btn-sm btn-primary-light">Voir tout</a>
			</div>

			<div class="row">

				<div class="col-lg-6 mb-3">
					<div class="card mb-0 h-100">
						<div class="card-header">
							<h3 class="card-title">Charges par catégorie (période sélectionnée)</h3>
						</div>
						<div class="card-body">
							<canvas id="graphiqueChargesCategorie" height="240"></canvas>
						</div>
					</div>
				</div>

				<div class="col-lg-6 mb-3">
					<div class="card mb-0 h-100">
						<div class="card-header">
							<h3 class="card-title">Détail des charges</h3>
						</div>
						<div class="table-responsive">
							<table class="table table-bordered table-hover mb-0">
								<thead>
									<tr>
										<th>Catégorie</th>
										<th class="text-right">Mouvements</th>
										<th class="text-right">Montant (FCFA)</th>
									</tr>
								</thead>
								<tbody>
									{% for ligne in chargesParCategorie %}
										<tr>
											<td>{{ ligne.categorie }}</td>
											<td class="text-right">{{ ligne.nombre }}</td>
											<td class="text-right">{{ ligne.montant|number_format(0, ',', ' ') }}</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="3" class="text-center text-muted py-4">Aucune charge sur cette période.</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>

			</div>


			{# ==========================================================
			   RENDEMENT MACHINE / TOP PRODUITS
			   ========================================================== #}

			<div class="section-accueil-titre">
				<h2><i class="fa fa-cogs mr-1"></i> Production</h2>
				<a href="{{ path('app_statistiques_globales_index') }}" class="btn btn-sm btn-primary-light">Voir tout</a>
			</div>

			<div class="row">

				<div class="col-lg-6 mb-3">
					<div class="card mb-0 h-100">
						<div class="card-header">
							<h3 class="card-title">Rendement par machine</h3>
						</div>
						<div class="card-body">
							<canvas id="graphiqueRendementMachine" height="220"></canvas>
						</div>
					</div>
				</div>

				<div class="col-lg-6 mb-3">
					<div class="card mb-0 h-100">
						<div class="card-header">
							<h3 class="card-title">Top des produits commandés</h3>
						</div>
						<div class="card-body">
							<canvas id="graphiqueTopProduits" height="220"></canvas>
						</div>
					</div>
				</div>

			</div>


			{# ==========================================================
			   CLIENTS
			   ========================================================== #}

			<div class="section-accueil-titre">
				<h2><i class="fa fa-users mr-1"></i> Clients</h2>
				<a href="{{ path('app_statistiques_clients_index') }}" class="btn btn-sm btn-primary-light">Voir tout</a>
			</div>

			<div class="row">

				<div class="col-lg-6 mb-3">
					<div class="card mb-0 h-100">
						<div class="card-header">
							<h3 class="card-title">Nouveaux clients enregistrés</h3>
						</div>
						<div class="card-body">
							<canvas id="graphiqueNouveauxClients" height="220"></canvas>
						</div>
					</div>
				</div>

				<div class="col-lg-6 mb-3">
					<div class="card mb-0 h-100">
						<div class="card-header">
							<h3 class="card-title">Chiffre d'affaires par client (top 10)</h3>
						</div>
						<div class="table-responsive">
							<table class="table table-bordered table-hover mb-0">
								<thead>
									<tr>
										<th>Client</th>
										<th class="text-right">Commandes</th>
										<th class="text-right">CA (FCFA)</th>
									</tr>
								</thead>
								<tbody>
									{% for ligne in caParClient %}
										<tr>
											<td>{{ ligne.nom }}</td>
											<td class="text-right">{{ ligne.nombre }}</td>
											<td class="text-right">{{ ligne.montant|number_format(0, ',', ' ') }}</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="3" class="text-center text-muted py-4">Aucune commande sur cette période.</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>

			</div>

		{% endif %}

	</div>

{% endblock %}

{% block javascripts %}

	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {

			document.querySelectorAll('.js-barre').forEach(function (barre) {
				const largeur = parseFloat(barre.dataset.largeur || '0');
				requestAnimationFrame(function () {
					barre.style.width = Math.max(0, Math.min(100, largeur)) + '%';
				});
			});

			document.querySelectorAll('.js-compteur').forEach(function (element) {
				const cible = parseInt(element.dataset.valeur || '0', 10);
				const suffixe = element.dataset.suffixe || '';
				const duree = 900;
				const depart = performance.now();

				function animer(maintenant) {
					const progres = Math.min(1, (maintenant - depart) / duree);
					const valeur = Math.round(cible * progres);
					element.textContent = valeur.toLocaleString('fr-FR') + suffixe;

					if (progres < 1) {
						requestAnimationFrame(animer);
					}
				}

				requestAnimationFrame(animer);
			});

			if (typeof Chart === 'undefined') {
				return;
			}

			var evolution = {{ evolution|json_encode|raw }};

			var canevasCa = document.getElementById('graphiqueEvolutionCa');

			if (canevasCa) {
				new Chart(canevasCa, {
					type: 'line',
					data: {
						labels: evolution.labels,
						datasets: [
							{
								label: 'Chiffre d\'affaires (FCFA)',
								data: evolution.ca,
								borderColor: '#467fcf',
								backgroundColor: 'rgba(70, 127, 207, 0.25)',
								fill: true,
								tension: 0.35,
								yAxisID: 'y'
							},
							{
								label: 'Commandes',
								data: evolution.commandes,
								borderColor: '#f1c40f',
								backgroundColor: 'rgba(241, 196, 15, 0.15)',
								fill: false,
								tension: 0.35,
								yAxisID: 'y1'
							}
						]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						interaction: { mode: 'index', intersect: false },
						plugins: {
							legend: { labels: { color: '#e7ecf5' } }
						},
						scales: {
							x: { ticks: { color: '#b9c4d6' }, grid: { color: 'rgba(255,255,255,0.06)' } },
							y: {
								position: 'left',
								beginAtZero: true,
								ticks: { color: '#b9c4d6' },
								grid: { color: 'rgba(255,255,255,0.06)' }
							},
							y1: {
								position: 'right',
								beginAtZero: true,
								ticks: { color: '#b9c4d6' },
								grid: { display: false }
							}
						}
					}
				});
			}

			var canevasEncDec = document.getElementById('graphiqueEncaissementsDecaissements');

			if (canevasEncDec) {
				new Chart(canevasEncDec, {
					type: 'bar',
					data: {
						labels: evolution.labels,
						datasets: [
							{
								label: 'Encaissements',
								data: evolution.encaissements,
								backgroundColor: '#5eba00'
							},
							{
								label: 'Décaissements',
								data: evolution.decaissements,
								backgroundColor: '#cd201f'
							}
						]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { labels: { color: '#e7ecf5' } }
						},
						scales: {
							x: { ticks: { color: '#b9c4d6' }, grid: { color: 'rgba(255,255,255,0.06)' } },
							y: { beginAtZero: true, ticks: { color: '#b9c4d6' }, grid: { color: 'rgba(255,255,255,0.06)' } }
						}
					}
				});
			}

			{% if peutVoirStatsGlobales %}

				var chargesParCategorie = {{ chargesParCategorie|json_encode|raw }};
				var parMachine = {{ parMachine|json_encode|raw }};
				var topProduits = {{ topProduits|json_encode|raw }};
				var nouveauxClients = {{ nouveauxClients|json_encode|raw }};

				var canevasCharges = document.getElementById('graphiqueChargesCategorie');

				if (canevasCharges) {
					var palette = ['#467fcf', '#5eba00', '#f1c40f', '#cd201f', '#6f42c1', '#17a2b8', '#fd7e14', '#20c997', '#e83e8c', '#6c757d'];

					new Chart(canevasCharges, {
						type: 'doughnut',
						data: {
							labels: chargesParCategorie.map(function (l) { return l.categorie; }),
							datasets: [{
								data: chargesParCategorie.map(function (l) { return l.montant; }),
								backgroundColor: chargesParCategorie.map(function (_, i) { return palette[i % palette.length]; })
							}]
						},
						options: { responsive: true, maintainAspectRatio: false }
					});
				}

				function creerGraphiqueBarres(idCanevas, donnees, cleValeur, libelle, couleur) {
					var canevas = document.getElementById(idCanevas);

					if (!canevas) {
						return;
					}

					new Chart(canevas, {
						type: 'bar',
						data: {
							labels: donnees.map(function (l) { return l.nom; }),
							datasets: [{
								label: libelle,
								data: donnees.map(function (l) { return l[cleValeur]; }),
								backgroundColor: couleur
							}]
						},
						options: {
							responsive: true,
							maintainAspectRatio: false,
							plugins: { legend: { display: false } },
							scales: { y: { beginAtZero: true } }
						}
					});
				}

				creerGraphiqueBarres('graphiqueRendementMachine', parMachine, 'quantite', 'Surface (m²)', '#6f42c1');
				creerGraphiqueBarres('graphiqueTopProduits', topProduits, 'nombre', 'Commandes', '#cd201f');

				var canevasNouveauxClients = document.getElementById('graphiqueNouveauxClients');

				if (canevasNouveauxClients) {
					new Chart(canevasNouveauxClients, {
						type: 'bar',
						data: {
							labels: nouveauxClients.labels,
							datasets: [{
								label: 'Nouveaux clients',
								data: nouveauxClients.valeurs,
								backgroundColor: '#6f42c1'
							}]
						},
						options: {
							responsive: true,
							maintainAspectRatio: false,
							plugins: { legend: { display: false } },
							scales: { y: { beginAtZero: true } }
						}
					});
				}

			{% endif %}

		});
	</script>

{% endblock %}
