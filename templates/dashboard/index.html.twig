{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block stylesheets %}
	<style>
		.dashboard-kpi {
			border-radius: 12px;
			overflow: hidden;
		}

		.dashboard-kpi .card-body {
			padding: 1.5rem;
		}

		.dashboard-kpi .kpi-valeur {
			font-size: 2rem;
			font-weight: 700;
			line-height: 1.1;
		}

		.dashboard-kpi .kpi-icone {
			width: 52px;
			height: 52px;
			border-radius: 12px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.4rem;
			color: #fff;
		}

		.agent-ligne {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: .85rem 0;
			border-bottom: 1px solid #eef0f5;
		}

		.agent-ligne:last-child {
			border-bottom: none;
		}

		.agent-avatar {
			width: 42px;
			height: 42px;
			min-width: 42px;
			border-radius: 50%;
			object-fit: cover;
			background: #6366f1;
			color: #fff;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: 600;
		}

		.agent-barre-piste {
			background: #eef0f5;
			border-radius: 6px;
			height: 8px;
			overflow: hidden;
			margin-top: .35rem;
		}

		.agent-barre-remplie {
			height: 100%;
			border-radius: 6px;
			background: linear-gradient(90deg, #6366f1, #22c55e);
			width: 0;
			transition: width 1s ease;
		}
	</style>
{% endblock %}

{% block body %}

	<div class="side-app">

		<div class="page-header">

			<div>
				<h1 class="page-title">Tableau de bord</h1>
				<ol class="breadcrumb">
					<li class="breadcrumb-item active">Accueil</li>
				</ol>
			</div>

			<div class="ml-auto btn-group">
				{% for cle, libelle in {
					jour: 'Aujourd’hui',
					semaine: 'Cette semaine',
					mois: 'Ce mois',
					annee: 'Cette année',
					tout: 'Tout'
				} %}
					<a href="{{ path('app_home', {periode: cle}) }}" class="btn btn-sm {{ periode == cle ? 'btn-primary' : 'btn-primary-light' }}">
						{{ libelle }}
					</a>
				{% endfor %}
			</div>

		</div>


		<div class="row">

			<div class="col-lg-4 col-md-6">
				<div class="card dashboard-kpi">
					<div class="card-body d-flex align-items-center justify-content-between">
						<div>
							<small class="text-muted d-block">Commandes traitées</small>
							<div class="kpi-valeur js-compteur" data-valeur="{{ totalCommandes }}">0</div>
						</div>
						<div class="kpi-icone" style="background:#6366f1;">
							<i class="fa fa-shopping-cart"></i>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-4 col-md-6">
				<div class="card dashboard-kpi">
					<div class="card-body d-flex align-items-center justify-content-between">
						<div>
							<small class="text-muted d-block">Chiffre d’affaires généré</small>
							<div class="kpi-valeur js-compteur" data-valeur="{{ totalCa }}" data-suffixe=" FCFA">0</div>
						</div>
						<div class="kpi-icone" style="background:#22c55e;">
							<i class="fa fa-money"></i>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-4 col-md-6">
				<div class="card dashboard-kpi">
					<div class="card-body d-flex align-items-center justify-content-between">
						<div>
							<small class="text-muted d-block">Clients enregistrés</small>
							<div class="kpi-valeur js-compteur" data-valeur="{{ totalClients }}">0</div>
						</div>
						<div class="kpi-icone" style="background:#f59e0b;">
							<i class="fa fa-users"></i>
						</div>
					</div>
				</div>
			</div>

		</div>


		<div class="card">

			<div class="card-header">
				<h3 class="card-title">Performance par agent</h3>
			</div>

			<div class="card-body">

				{% if statsParAgent|length == 0 %}

					<p class="text-muted text-center py-4 mb-0">
						<i class="fa fa-info-circle mr-1"></i>
						Aucune commande sur cette période.
					</p>

				{% else %}

					{% for ligne in statsParAgent %}

						{% set employe = ligne.agent.employe %}
						{% set nomAgent = employe ? (employe.prenom ~ ' ' ~ employe.nom) : ligne.agent.username %}
						{% set pourcentage = meilleurCa > 0 ? (ligne.caGenere / meilleurCa * 100) : 0 %}

						<div class="agent-ligne">

							{% if employe and employe.photos %}
								<img src="{{ asset('uploads/employes/' ~ employe.photos) }}" class="agent-avatar" alt="{{ nomAgent }}">
							{% else %}
								<div class="agent-avatar">
									{{ nomAgent|slice(0, 1)|upper }}
								</div>
							{% endif %}

							<div class="flex-fill">

								<div class="d-flex justify-content-between">
									<strong>{{ nomAgent }}</strong>
									<span class="text-muted">
										{{ ligne.nbCommandes }}
										commande{{ ligne.nbCommandes > 1 ? 's' : '' }}
										—
										<strong class="text-success">
											{{ ligne.caGenere|number_format(0, ',', ' ') }} FCFA
										</strong>
									</span>
								</div>

								<div class="agent-barre-piste">
									<div class="agent-barre-remplie js-barre" data-largeur="{{ pourcentage }}"></div>
								</div>

							</div>

						</div>

					{% endfor %}

				{% endif %}

			</div>

		</div>

	</div>

{% endblock %}

{% block javascripts %}
	<script>
		document.addEventListener('DOMContentLoaded', function () {

			document.querySelectorAll('.js-barre').forEach(function (barre) {
				const largeur = parseFloat(barre.dataset.largeur || '0');
				requestAnimationFrame(function () {
					barre.style.width = Math.max(0, Math.min(100, largeur)) + '%';
				});
			});

			document.querySelectorAll('.js-compteur').forEach(function (element) {
				const cible = parseInt(element.dataset.valeur || '0', 10);
				const suffixe = element.dataset.suffixe || '';
				const duree = 900;
				const depart = performance.now();

				function animer(maintenant) {
					const progres = Math.min(1, (maintenant - depart) / duree);
					const valeur = Math.round(cible * progres);
					element.textContent = valeur.toLocaleString('fr-FR') + suffixe;

					if (progres < 1) {
						requestAnimationFrame(animer);
					}
				}

				requestAnimationFrame(animer);
			});

		});
	</script>
{% endblock %}
