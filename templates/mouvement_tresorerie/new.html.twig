{% extends 'base.html.twig' %}

{% block title %}
	Nouveau mouvement de trésorerie
{% endblock %}

{% block body %}

	{% set estAssistante = estAssistante|default(
        is_granted('ROLE_ASSISTANTE_COMMERCIALE')
    ) %}

	<div
		class="side-app">

		{# Les messages Flash sont lus une seule fois. #}
		{% for type, messages in app.flashes %}
			{% for message in messages %}
				<div class="js-flash-message" data-type="{{ type|e('html_attr') }}" data-message="{{ message|e('html_attr') }}"></div>
			{% endfor %}
		{% endfor %}

		<div class="page-header">
			<ol class="breadcrumb">

				<li class="breadcrumb-item">
					<a href="#">Gestion</a>
				</li>

				{% if is_granted('ROLE_RESPONSABLE_GESTION') %}
					<li class="breadcrumb-item">
						<a href="{{ path('app_compte_tresorerie_index') }}">
							Trésorerie
						</a>
					</li>
				{% endif %}

				<li class="breadcrumb-item">
					<a href="{{ path('app_mouvement_tresorerie_index') }}">
						Mouvements
					</a>
				</li>

				<li class="breadcrumb-item active">
					Nouveau
				</li>

			</ol>
		</div>

		<div class="card">

			<div class="card-header">
				<h3 class="card-title">
					Enregistrer un mouvement de trésorerie
				</h3>
			</div>

			<div class="card-body">

				<div class="alert alert-info mb-4">

					<i class="fa fa-info-circle mr-1"></i>

					<strong>Encaissement :</strong>
					crédite le compte destination.

					<br>

					<strong>Décaissement :</strong>
					débite le compte source.

					{% if not estAssistante %}
						<br>

						<strong>Transfert :</strong>
						débite le compte source et crédite le compte destination.
					{% endif %}

				</div>

				{% if estAssistante %}
					<div class="alert alert-warning mb-4">
						<i class="fa fa-lock mr-1"></i>

						Vous pouvez enregistrer uniquement un encaissement
												                        ou un décaissement.
					</div>
				{% endif %}

				{% include 'mouvement_tresorerie/_form.html.twig' with {
                    form: form,
                    bouton_label: 'Enregistrer le mouvement',
                    estAssistante: estAssistante
                } only %}

			</div>

		</div>

	</div>

{% endblock %}

{% block javascripts %}

	{{ parent() }}

	<script src="{{ asset( 'assets/plugins/sweet-alert/sweetalert2.all.min.js' ) }}"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
const flashMessages = document.querySelectorAll('.js-flash-message');

flashMessages.forEach(function (element) {
const type = element.dataset.type || 'info';
const message = element.dataset.message || '';

let icon = 'info';
let title = 'Information';
let confirmButtonText = 'D’accord';

if (type === 'success') {
icon = 'success';
title = 'Opération réussie';
confirmButtonText = 'OK';
} else if (type === 'error' || type === 'danger') {
icon = 'error';
title = message.toLowerCase().includes('solde') ? 'Solde insuffisant' : 'Opération impossible';

confirmButtonText = 'Corriger';
} else if (type === 'warning') {
icon = 'warning';
title = 'Attention';
}

Swal.fire({
icon: icon,
title: title,
text: message,
confirmButtonText: confirmButtonText,
confirmButtonColor: '#6259ca',
allowOutsideClick: false
});
});
});
	</script>

{% endblock %}
