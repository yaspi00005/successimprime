{% extends 'base.html.twig' %}

{% block title %}
	Mouvements de trésorerie
{% endblock %}

{% block body %}

	<div class="side-app">

		<div class="page-header">

			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="#">Gestion</a>
				</li>

				<li class="breadcrumb-item">
					<a href="{{ path( 'app_compte_tresorerie_index' ) }}">
						Trésorerie
					</a>
				</li>

				<li class="breadcrumb-item active">
					Mouvements
				</li>
			</ol>

			<div>

				<a href="{{ path( 'app_compte_tresorerie_index' ) }}" class="btn btn-secondary">
					<i class="fa fa-wallet mr-1"></i>
					Comptes
				</a>

				<a href="{{ path( 'app_mouvement_tresorerie_new' ) }}" class="btn btn-primary">
					<i class="fa fa-plus mr-1"></i>
					Nouveau mouvement
				</a>

			</div>

		</div>

		{% for type, messages in app.flashes %}
			{% for message in messages %}

				{% set classe = type == 'success'
                ? 'alert-success'
                : (
                    type == 'warning'
                        ? 'alert-warning'
                        : 'alert-danger'
                )
            %}

				<div class="alert {{ classe }}
																														                    alert-dismissible fade show">
					{{ message }}

					<button type="button" class="close" data-dismiss="alert">
						<span>&times;</span>
					</button>
				</div>

			{% endfor %}
		{% endfor %}

		<div class="card">
			<div class="card-header">
				<h3 class="card-title">
					<i class="fa fa-filter mr-2"></i>
					Filtrer les mouvements
				</h3>

				<div class="card-options">
					<a href="{{ path('app_mouvement_tresorerie_index') }}" class="btn btn-sm btn-light">
						<i class="fa fa-refresh mr-1"></i>
						Réinitialiser
					</a>
				</div>
			</div>

			<div class="card-body">
				<form method="get">
					<div class="row">

						<div class="col-lg-4 col-md-6">
							<div class="form-group">
								<label>Recherche</label>

								<input type="text" name="recherche" class="form-control" value="{{ filtres.recherche }}" placeholder="Référence, libellé...">
							</div>
						</div>

						<div class="col-lg-4 col-md-6">
							<div class="form-group">
								<label>Compte</label>

								<select name="compte" class="form-control">
									<option value="">Tous les comptes</option>

									{% for compte in comptes %}
										<option value="{{ compte.id }}" {{ filtres.compte == compte.id ? 'selected' : '' }}>
											{{ compte.nom }}
										</option>
									{% endfor %}
								</select>
							</div>
						</div>

						<div class="col-lg-4 col-md-6">
							<div class="form-group">
								<label>Agent</label>

								<select name="agent" class="form-control">
									<option value="">Tous les agents</option>

									{% for agent in agents %}
										<option value="{{ agent.id }}" {{ filtres.agent == agent.id ? 'selected' : '' }}>
											{% if agent.employe %}
												{{ agent.employe.prenom }}
												{{ agent.employe.nom }}
											{% else %}
												{{ agent.username }}
											{% endif %}
										</option>
									{% endfor %}
								</select>
							</div>
						</div>

						<div class="col-lg-3 col-md-6">
							<div class="form-group">
								<label>Période rapide</label>

								<select name="periode" class="form-control">
									<option value="">Période personnalisée</option>
									<option value="aujourdhui" {{ periode == 'aujourdhui' ? 'selected' : '' }}>
										Aujourd’hui
									</option>
									<option value="hier" {{ periode == 'hier' ? 'selected' : '' }}>
										Hier
									</option>
									<option value="semaine" {{ periode == 'semaine' ? 'selected' : '' }}>
										Cette semaine
									</option>
									<option value="mois" {{ periode == 'mois' ? 'selected' : '' }}>
										Ce mois
									</option>
									<option value="annee" {{ periode == 'annee' ? 'selected' : '' }}>
										Cette année
									</option>
								</select>
							</div>
						</div>

						<div class="col-lg-3 col-md-6">
							<div class="form-group">
								<label>Date début</label>

								<input type="date" name="dateDebut" class="form-control" value="{{ filtres.dateDebut }}">
							</div>
						</div>

						<div class="col-lg-3 col-md-6">
							<div class="form-group">
								<label>Date fin</label>

								<input type="date" name="dateFin" class="form-control" value="{{ filtres.dateFin }}">
							</div>
						</div>

						<div class="col-lg-3 col-md-6">
							<div class="form-group">
								<label>Type</label>

								<select name="type" class="form-control">
									<option value="">Tous les types</option>
									<option value="encaissement" {{ filtres.type == 'encaissement' ? 'selected' : '' }}>
										Encaissement
									</option>
									<option value="decaissement" {{ filtres.type == 'decaissement' ? 'selected' : '' }}>
										Décaissement
									</option>
									<option value="transfert" {{ filtres.type == 'transfert' ? 'selected' : '' }}>
										Transfert
									</option>
								</select>
							</div>
						</div>

						<div class="col-lg-4 col-md-6">
							<div class="form-group">
								<label>Statut</label>

								<select name="statut" class="form-control">
									<option value="">Tous les statuts</option>
									<option value="valide" {{ filtres.statut == 'valide' ? 'selected' : '' }}>
										Validé
									</option>
									<option value="en_attente" {{ filtres.statut == 'en_attente' ? 'selected' : '' }}>
										En attente
									</option>
									<option value="annule" {{ filtres.statut == 'annule' ? 'selected' : '' }}>
										Annulé
									</option>
								</select>
							</div>
						</div>

						<div class="col-lg-4 col-md-6">
							<div class="form-group">
								<label>Mode de paiement</label>

								<select name="modePaiement" class="form-control">
									<option value="">Tous les modes</option>
									<option value="especes" {{ filtres.modePaiement == 'especes' ? 'selected' : '' }}>
										Espèces
									</option>
									<option value="orange_money" {{ filtres.modePaiement == 'orange_money' ? 'selected' : '' }}>
										Orange Money
									</option>
									<option value="wave" {{ filtres.modePaiement == 'wave' ? 'selected' : '' }}>
										Wave
									</option>
									<option value="cheque" {{ filtres.modePaiement == 'cheque' ? 'selected' : '' }}>
										Chèque
									</option>
									<option value="virement" {{ filtres.modePaiement == 'virement' ? 'selected' : '' }}>
										Virement bancaire
									</option>
								</select>
							</div>
						</div>

						<div class="col-lg-4 col-md-12">
							<div class="form-group">
								<label>&nbsp;</label>

								<button type="submit" class="btn btn-primary btn-block">
									<i class="fa fa-search mr-1"></i>
									Appliquer les filtres
								</button>
							</div>
						</div>

					</div>
				</form>
			</div>
		</div>
		<div class="row">

			<div class="col-xl-3 col-md-6">
				<div class="card bg-success text-white">
					<div class="card-body">
						<p class="mb-1 text-white">Encaissements validés</p>
						<h3 class="text-white mb-0">
							{{ totaux.encaissements|number_format(0, ',', ' ') }}
							FCFA
						</h3>
					</div>
				</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<div class="card bg-danger text-white">
					<div class="card-body">
						<p class="mb-1 text-white">Décaissements validés</p>
						<h3 class="text-white mb-0">
							{{ totaux.decaissements|number_format(0, ',', ' ') }}
							FCFA
						</h3>
					</div>
				</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<div class="card bg-primary text-white">
					<div class="card-body">
						<p class="mb-1 text-white">Solde net de la période</p>
						<h3 class="text-white mb-0">
							{{ totaux.soldeNet|number_format(0, ',', ' ') }}
							FCFA
						</h3>
					</div>
				</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<div class="card bg-info text-white">
					<div class="card-body">
						<p class="mb-1 text-white">Mouvements trouvés</p>
						<h3 class="text-white mb-0">
							{{ totaux.nombre }}
						</h3>
					</div>
				</div>
			</div>

		</div>
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">
					Historique des mouvements
				</h3>
			</div>

			<div class="card-body">

				<div class="table-responsive">

					<table class="table table-bordered table-hover">

						<thead>
							<tr>
								<th>Date</th>
								<th>Référence</th>
								<th>Type</th>
								<th>Libellé</th>
								<th>Compte</th>
								<th class="text-right">Montant</th>
								<th>Statut</th>
								<th>Agent</th>
								<th width="80">Action</th>
							</tr>
						</thead>

						<tbody>

							{% for mouvement in mouvements %}

								<tr>

									<td>
										{{
                                        mouvement.dateOperation
                                            ? mouvement.dateOperation
                                                |date('d/m/Y H:i')
                                            : '—'
                                    }}
									</td>

									<td>
										<strong>
											{{ mouvement.reference }}
										</strong>

										{% if mouvement.referenceExterne %}
											<br>
											<small class="text-muted">
												{{ mouvement.referenceExterne }}
											</small>
										{% endif %}
									</td>

									<td>

										{% if mouvement.type == 'encaissement' %}
											<span class="badge badge-success">
												Encaissement
											</span>
										{% elseif mouvement.type == 'decaissement' %}
											<span class="badge badge-danger">
												Décaissement
											</span>
										{% elseif mouvement.type == 'transfert' %}
											<span class="badge badge-primary">
												Transfert
											</span>
										{% else %}
											<span class="badge badge-secondary">
												{{ mouvement.type }}
											</span>
										{% endif %}

									</td>

									<td>
										{{ mouvement.libelle }}
									</td>

									<td>

										{% if mouvement.type == 'encaissement' %}
											<i class="fa fa-arrow-right text-success"></i>

											{{
                                            mouvement.compteDestination
                                                ? mouvement.compteDestination.nom
                                                : '—'
                                        }}

										{% elseif mouvement.type == 'decaissement' %}
											{{
                                            mouvement.compteSource
                                                ? mouvement.compteSource.nom
                                                : '—'
                                        }}

											<i class="fa fa-arrow-right text-danger"></i>

										{% elseif mouvement.type == 'transfert' %}
											{{
                                            mouvement.compteSource
                                                ? mouvement.compteSource.nom
                                                : '—'
                                        }}

											<i class="fa fa-arrow-right text-primary"></i>

											{{
                                            mouvement.compteDestination
                                                ? mouvement.compteDestination.nom
                                                : '—'
                                        }}
										{% endif %}

									</td>

									<td class="text-right">
										<strong>
											{{
                                            mouvement.montant
                                                |number_format(0, ',', ' ')
                                        }}
											{{ mouvement.devise }}
										</strong>
									</td>

									<td>

										{% if mouvement.statut == 'valide' %}
											<span class="badge badge-success">
												Validé
											</span>
										{% elseif mouvement.statut == 'en_attente' %}
											<span class="badge badge-warning">
												En attente
											</span>
										{% elseif mouvement.statut == 'annule' %}
											<span class="badge badge-danger">
												Annulé
											</span>
										{% else %}
											<span class="badge badge-secondary">
												{{ mouvement.statut }}
											</span>
										{% endif %}

									</td>
									<td>
										{% if mouvement.agent %}
											{% if mouvement.agent.employe %}
												{{ mouvement.agent.employe.prenom }}
												{{ mouvement.agent.employe.nom }}
											{% else %}
												{{ mouvement.agent.username }}
											{% endif %}
										{% else %}
											<span class="text-muted">—</span>
										{% endif %}
									</td>
									<td class="text-center">

										<a href="{{ path( 'app_mouvement_tresorerie_show', {id: mouvement.id} ) }}" class="btn btn-sm btn-primary" title="Consulter">
											<i class="fa fa-eye"></i>
										</a>

									</td>

								</tr>

							{% else %}

								<tr>
									<td colspan="9" class="text-center text-muted py-5">
										<i class="fa fa-exchange fa-3x mb-3"></i>

										<p>
											Aucun mouvement de trésorerie
																																																							                                        n’a encore été enregistré.
										</p>

										<a href="{{ path( 'app_mouvement_tresorerie_new' ) }}" class="btn btn-primary">
											Enregistrer le premier mouvement
										</a>
									</td>
								</tr>

							{% endfor %}

						</tbody>

					</table>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
