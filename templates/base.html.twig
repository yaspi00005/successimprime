			{% if app.user %}

				<script>
					(function () {

						if (typeof window.Notification === 'undefined') {
							return;
						}

						/*
						 * Safari (macOS) exige un clic explicite de
						 * l'utilisateur pour demander la permission :
						 * un appel automatique au chargement de la page
						 * est ignoré silencieusement (contrairement à
						 * Chrome, qui l'accepte, d'où la différence de
						 * comportement Mac/Windows constatée). On affiche
						 * donc un lien cliquable tant que la permission
						 * n'a pas été demandée.
						 */
						const lienActivation = document.querySelector('.js-activer-alertes-navigateur');

						if (Notification.permission === 'default' && lienActivation) {
							lienActivation.style.display = '';

							lienActivation.addEventListener('click', function (evenement) {
								evenement.preventDefault();

								Notification.requestPermission().then(function () {
									lienActivation.style.display = 'none';
								});
							});
						}

						let dernierTotalConnu = {{ totalNotifications|default(0) }};

						function verifierNouvellesNotifications() {

							fetch("{{ path('app_notification_etat') }}", {
								headers: {Accept: 'application/json'}
							})
								.then(function (reponse) {
									return reponse.json();
								})
								.then(function (donnees) {

									const total = donnees.total || 0;

									if (total > dernierTotalConnu && Notification.permission === 'granted') {

										const notification = new Notification('Successimprime', {
											body: total + ' notification(s) non lue(s).',
											icon: "{{ asset('favicon.ico') }}"
										});

										notification.onclick = function () {
											window.focus();
											notification.close();
										};
									}

									dernierTotalConnu = total;
								})
								.catch(function (erreur) {
									console.error('Erreur verification notifications :', erreur);
								});
						}

						setInterval(verifierNouvellesNotifications, 30000);

					})();
				</script>

			{% endif %}

		</body>

	</html>
