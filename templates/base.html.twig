<!doctype html>

<html lang="fr" dir="ltr" data-turbo="false" translate="no" class="notranslate">

	{% set routeCourante = app.request.attributes.get('_route')|default('') %}


	{% set peutVoirClients =
		is_granted('ROLE_CLIENT')
	%}


	{% set peutVoirDevis =
		is_granted('ROLE_DEVIS')
	%}


	{% set peutVoirCommandes =
		is_granted('ROLE_COMMANDE')
	%}


	{% set peutVoirLivraison =
		is_granted('ROLE_LIVRAISON')
	%}


	{% set peutVoirCommercial =
		peutVoirClients
		or peutVoirDevis
		or peutVoirCommandes
		or peutVoirLivraison
	%}


	{# ================================================================
													   PRODUCTION
													   ================================================================ #}

	{% set peutVoirProduction =
		is_granted('ROLE_PRODUCTION_VOIR')
	%}


	{% set peutGererProduction =
		is_granted('ROLE_PRODUCTION_GERER')
	%}


	{# ================================================================
													   PRÉPRESSE
													   
													   INFOGRAPHISTE UNIQUEMENT
													   + ADMIN PAR HÉRITAGE
													   ================================================================ #}

	{% set peutVoirPrepresse =
		is_granted('ROLE_PREPRESSE')
	%}


	{# ================================================================
													   STOCK / ACHATS
													   
													   ADMIN UNIQUEMENT
													   ================================================================ #}

	{% set peutVoirStocks =
		is_granted('ROLE_ADMIN')
	%}


	{# ================================================================
													   FACTURATION
													   ================================================================ #}

	{% set peutVoirFactures =
		is_granted('ROLE_FACTURE')
	%}


	{% set peutVoirPaiements =
		is_granted('ROLE_PAIEMENT_VOIR')
	%}


	{# ================================================================
													   TRÉSORERIE
													   ================================================================ #}

	{% set peutVoirTresorerie =
		is_granted('ROLE_TRESORERIE_VOIR')
	%}


	{% set peutSaisirTresorerie =
		is_granted('ROLE_TRESORERIE_SAISIR')
	%}


	{% set peutVoirJournalCaisse =
		is_granted('ROLE_ADMIN')
	%}


	{% set peutVoirComptesTresorerie =
		is_granted('ROLE_ADMIN')
	%}


	{% set peutVoirRapprochement =
		is_granted('ROLE_RAPPROCHEMENT_BANCAIRE')
	%}


	{# ================================================================
													   STATISTIQUES
													   ================================================================ #}

	{% set peutVoirStatsGlobales =
		is_granted('ROLE_STATS_GLOBAL')
	%}


	{% set peutVoirMesStats =
		is_granted('ROLE_CAISSE_COMMANDE')
		or is_granted('ROLE_ADMIN')
	%}


	{# ================================================================
													   GESTION
													   ================================================================ #}

	{% set peutVoirGestion =
		peutVoirFactures
		or peutVoirPaiements
		or peutVoirTresorerie
		or peutVoirComptesTresorerie
		or peutVoirJournalCaisse
		or peutVoirRapprochement
		or peutVoirMesStats
		or peutVoirStatsGlobales
	%}


	{# ================================================================
													   RH
													   
													   ADMIN UNIQUEMENT
													   ================================================================ #}

	{% set peutVoirRh =
		is_granted('ROLE_ADMIN')
	%}


	{# ================================================================
													   PARAMÈTRES
													   
													   ADMIN UNIQUEMENT
													   ================================================================ #}

	{% set peutVoirParametres =
		is_granted('ROLE_ADMIN')
	%}


	{# ================================================================
													   MENU ACTIF SELON LA ROUTE
													   ================================================================ #}

	{% set menuActif = 'accueil' %}


	{% if
		routeCourante starts with 'app_clients_'
		or routeCourante starts with 'app_commandes_'
		or routeCourante starts with 'app_devis_'
		or routeCourante starts with 'app_livraisons_'
		or routeCourante starts with 'app_bon_livraison_'
	%}

		{% set menuActif = 'commercial' %}


	{% elseif
		routeCourante starts with 'app_production_'
		or routeCourante starts with 'app_controle_pre_presse_'
		or routeCourante starts with 'app_ordre_fabrication_'
	%}

		{% set menuActif = 'production' %}


	{% elseif
		routeCourante starts with 'app_stock_'
		or routeCourante starts with 'app_article_'
		or routeCourante starts with 'app_fournisseur_'
		or routeCourante starts with 'app_achat_'
		or routeCourante starts with 'app_inventaire_'
	%}

		{% set menuActif = 'stocks' %}


	{% elseif
		routeCourante starts with 'app_factures_'
		or routeCourante starts with 'app_paiements_'
		or routeCourante starts with 'app_compte_tresorerie_'
		or routeCourante starts with 'app_mouvement_tresorerie_'
		or routeCourante starts with 'app_encaissement_'
		or routeCourante starts with 'app_decaissement_'
		or routeCourante starts with 'app_transfert_tresorerie_'
		or routeCourante starts with 'app_rapprochement_bancaire_'
		or routeCourante starts with 'app_journal_caisse_'
		or routeCourante starts with 'app_mes_statistiques_'
		or routeCourante starts with 'app_statistiques_globales_'
	%}

		{% set menuActif = 'gestion' %}


	{% elseif
		routeCourante starts with 'app_employes_'
		or routeCourante starts with 'app_user_'
		or routeCourante starts with 'app_journal_activite_'
	%}

		{% set menuActif = 'rh' %}


	{% elseif
		routeCourante starts with 'app_categorie_produit_'
		or routeCourante starts with 'app_produits_'
		or routeCourante starts with 'app_produit_configuration_'
		or routeCourante starts with 'app_type_impression_'
		or routeCourante starts with 'app_support_'
		or routeCourante starts with 'app_format_'
		or routeCourante starts with 'app_finition_'
		or routeCourante starts with 'app_machines_'
		or routeCourante starts with 'app_lot_etiquette_'
	%}

		{% set menuActif = 'parametres' %}


	{% elseif
		routeCourante starts with 'app_reclamation_'
	%}

		{% set menuActif = 'reclamations' %}

	{% elseif
		routeCourante starts with 'app_chat_'
	%}

		{% set menuActif = 'messagerie' %}


	{% endif %}


	{# ================================================================
													   SÉCURITÉ VISUELLE DU MENU
													   ================================================================ #}

	{% if menuActif == 'commercial' and not peutVoirCommercial %}
		{% set menuActif = 'accueil' %}
	{% endif %}


	{% if menuActif == 'production' and not peutVoirProduction %}
		{% set menuActif = 'accueil' %}
	{% endif %}


	{% if menuActif == 'stocks' and not peutVoirStocks %}
		{% set menuActif = 'accueil' %}
	{% endif %}


	{% if menuActif == 'gestion' and not peutVoirGestion %}
		{% set menuActif = 'accueil' %}
	{% endif %}


	{% if menuActif == 'rh' and not peutVoirRh %}
		{% set menuActif = 'accueil' %}
	{% endif %}


	{% if menuActif == 'parametres' and not peutVoirParametres %}
		{% set menuActif = 'accueil' %}
	{% endif %}


	<head>

		<meta charset="UTF-8">

		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0">

		<meta
		http-equiv="X-UA-Compatible" content="IE=edge">

		{#
															Empêche la traduction automatique du navigateur (Google
															Translate, etc.). Cette page manipule beaucoup le DOM en
															JavaScript (ajout de lignes, envoi de fichiers...) ; si le
															navigateur a traduit la page, il modifie lui aussi le DOM
															en parallèle, ce qui entre en conflit avec nos scripts et
															peut faire planter/geler l'affichage (écran qui reste
															bleu vide, par exemple pendant l'envoi d'un fichier).
														#}
		<meta name="google" content="notranslate">

		<meta name="msapplication-TileColor" content="#0061da">

		<meta name="theme-color" content="#1643a3">

		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

		<meta name="apple-mobile-web-app-capable" content="yes">

		<meta name="mobile-web-app-capable" content="yes">


		<link rel="icon" href="{{ asset('assets/images/brand/favicon.png') }}" type="image/x-icon">


		<title>
			{% block title %}
				MDG - ERP
			{% endblock %}
		</title>


		<link href="{{ asset('assets/css/dashboard.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/css/color-themes.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/side-menu/full-sidemenu.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/sidemenu-responsive-tabs/css/easy-responsive-tabs.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/pscrollbar/perfect-scrollbar.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/single-page/css/main.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/charts-c3/c3-chart.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/mcustomscrollbar/jquery.mCustomScrollbar.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/css/icons.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/sidebar/sidebar.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/jquery-jside-menu-master/css/jside-menu.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/jquery-jside-menu-master/css/jside-skins.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/horizontal-menu/dropdown-effects/fade-down.css') }}" rel="stylesheet">

		<link href="{{ asset('assets/plugins/horizontal-menu/horizontal-menu.css') }}" rel="stylesheet">


		<style>

			#parentVerticalTab .resp-tabs-list li.resp-tab-active,
			#parentVerticalTab .resp-tabs-list li.active {

				background: #1643a3 !important;

				color: #fff !important;
			}


			#parentVerticalTab .resp-tabs-list li.resp-tab-active i,
			#parentVerticalTab .resp-tabs-list li.active i {

				color: #fff !important;
			}


			#parentVerticalTab .slide-item.active {

				background: rgba(22, 67, 163, 0.12);

				border-left: 3px solid #1643a3;

				color: #1643a3 !important;

				font-weight: 600;
			}


			.notifyimg {

				width: 42px;
				height: 42px;

				border-radius: 50%;

				display: flex;
				align-items: center;
				justify-content: center;

				color: #fff;
				font-size: 16px;

				flex-shrink: 0;

				margin-right: 12px;
			}


			.notifications .dropdown-menu,
			.messagerie .dropdown-menu {

				max-width: 380px;
			}


			.notifications .dropdown-item,
			.messagerie .dropdown-item {

				white-space: normal;
			}
		</style>


		{% block stylesheets %}{% endblock %}

	</head>


	<body
		class="app sidebar-mini" data-turbo="false">


		{# ============================================================
																										   LOADER
																										   ============================================================ #}

		<div id="global-loader">

			<img src="{{ asset('assets/images/loader.svg') }}" class="loader-img" alt="Chargement">

		</div>


		<div class="page">

			<div class="page-main">


				<div class="app-sidebar__overlay" data-toggle="sidebar"></div>


				{# ============================================================
																																																				   SIDEBAR
																																																				   ============================================================ #}

				<aside
					class="app-sidebar">


					{# ====================================================
																																																																	   LOGO
																																																																	   ==================================================== #}

					<a class="
																																																																															header-brand
																																																																															left-meu-header-brand
																																																																															left-meu-header-brand-desktop
																																																																														" href="{{ path('app_home') }}">

						<img src="{{ asset('assets/images/brand/logo2.png') }}" class="header-brand-img desktop-logo" alt="MDG ERP">

						<img src="{{ asset('assets/images/brand/favicon.png') }}" class="header-brand-img mobile-view-logo" alt="MDG ERP">

					</a>


					{# ====================================================
																																																																	   RECHERCHE MENU
																																																																	   ==================================================== #}

					<div class="input-group p-2 bg-white border-bottom">

						<input id="menuSearch" type="search" placeholder="Rechercher un menu..." class="form-control search" autocomplete="off">

						<div class="input-group-prepend mr-0">

							<span class="
																																																																																																																					input-group-text
																																																																																																																					border-right
																																																																																																																					search_btn
																																																																																																																					btn-primary-default
																																																																																																																				">

								<i class="fa fa-search text-white"></i>

							</span>

						</div>

					</div>


					<div class="side-tab-body p-0 border-0" id="parentVerticalTab">

						<div
							class="first-sidemenu">


							{# =================================================
																																																																																											   PREMIER MENU
																																																																																											   ================================================= #}

							<ul
								class="resp-tabs-list hor_1">


								{# =============================================
																																																																																																								   ACCUEIL
																																																																																																								   ============================================= #}

								<li class="{{ menuActif == 'accueil' ? 'resp-tab-active active' : '' }}" data-menu="accueil" title="Accueil">

									<i class="
																																																																																																																																			side-menu__icon
																																																																																																																																			typcn
																																																																																																																																			typcn-home-outline
																																																																																																																																		"></i>

									<div class="slider-text">
										Accueil
									</div>

								</li>


								{# =============================================
																																																																																																								   COMMERCIAL
																																																																																																								   ============================================= #}

								{% if peutVoirCommercial %}

									<li class="{{ menuActif == 'commercial' ? 'resp-tab-active active' : '' }}" data-menu="commercial" title="Commercial">

										<i class="
																																																																																																																																																side-menu__icon
																																																																																																																																																typcn
																																																																																																																																																typcn-shopping-cart
																																																																																																																																															"></i>

										<div class="slider-text">
											Commercial
										</div>

									</li>

								{% endif %}


								{# =============================================
																																																																																																								   PRODUCTION
																																																																																																								   ============================================= #}

								{% if peutVoirProduction %}

									<li class="{{ menuActif == 'production' ? 'resp-tab-active active' : '' }}" data-menu="production" title="Production">

										<i class="
																																																																																																																																																side-menu__icon
																																																																																																																																																typcn
																																																																																																																																																typcn-cog-outline
																																																																																																																																															"></i>

										<div class="slider-text">
											Production
										</div>

									</li>

								{% endif %}


								{# =============================================
																																																																																																								   STOCK
																																																																																																								   ============================================= #}

								{% if peutVoirStocks %}

									<li class="{{ menuActif == 'stocks' ? 'resp-tab-active active' : '' }}" data-menu="stocks" title="Stocks et achats">

										<i class="
																																																																																																																																																side-menu__icon
																																																																																																																																																typcn
																																																																																																																																																typcn-archive
																																																																																																																																															"></i>

										<div class="slider-text">
											Stocks
										</div>

									</li>

								{% endif %}


								{# =============================================
																																																																																																								   GESTION
																																																																																																								   ============================================= #}

								{% if peutVoirGestion %}

									<li class="{{ menuActif == 'gestion' ? 'resp-tab-active active' : '' }}" data-menu="gestion" title="Gestion et trésorerie">

										<i class="
																																																																																																																																																side-menu__icon
																																																																																																																																																typcn
																																																																																																																																																typcn-chart-line-outline
																																																																																																																																															"></i>

										<div class="slider-text">
											Gestion
										</div>

									</li>

								{% endif %}


								{# =============================================
																																																																																																								   RH
																																																																																																								   ============================================= #}

								{% if peutVoirRh %}

									<li class="{{ menuActif == 'rh' ? 'resp-tab-active active' : '' }}" data-menu="rh" title="Ressources humaines">

										<i class="
																																																																																																																																																side-menu__icon
																																																																																																																																																typcn
																																																																																																																																																typcn-group-outline
																																																																																																																																															"></i>

										<div class="slider-text">
											RH
										</div>

									</li>

								{% endif %}


								{# =============================================
																																																																																																								   PARAMÈTRES
																																																																																																								   ============================================= #}

								{% if peutVoirParametres %}

									<li class="{{ menuActif == 'parametres' ? 'resp-tab-active active' : '' }}" data-menu="parametres" title="Catalogue et paramètres">

										<i class="
																																																																																																																																																side-menu__icon
																																																																																																																																																typcn
																																																																																																																																																typcn-spanner-outline
																																																																																																																																															"></i>

										<div class="slider-text">
											Paramètres
										</div>

									</li>

								{% endif %}


								{# =============================================
																																																																								   RÉCLAMATIONS
																																																								
																																																																								   Accessible à tous les utilisateurs connectés.
																																																																								   ============================================= #}

								<li class="{{ menuActif == 'reclamations' ? 'resp-tab-active active' : '' }}" data-menu="reclamations" title="Réclamations">

									<i class="
																																																																																													side-menu__icon
																																																																																													fa
																																																																																													fa-money
																																																																																												"></i>

									<div class="slider-text">
										Réclamations
									</div>

								</li>

								<li class="{{ menuActif == 'messagerie' ? 'resp-tab-active active' : '' }}" data-menu="messagerie" title="Messagerie">

									<i class="side-menu__icon fa fa-comments"></i>

									<div class="slider-text">
										Messagerie
									</div>

								</li>


							</ul>


							{# =================================================
																																																																																											   SECOND MENU
																																																																																											   ================================================= #}

							<div class="second-sidemenu">

								<div
									class="resp-tabs-container hor_1">


									{# =================================================
																																																																																																																					   ACCUEIL
																																																																																																																					   ================================================= #}

									<div data-panel="accueil" class="{{ menuActif == 'accueil' ? 'resp-tab-content-active' : '' }}">

										<div class="row">

											<div class="col-md-12">

												<h4 class="font-weight-normal">

													<i class="
																																																																																																																																																																																							typcn
																																																																																																																																																																																							typcn-home-outline
																																																																																																																																																																																						"></i>

													Accueil

												</h4>


												<a href="{{ path('app_home') }}" class="
																																																																																																																																																																																						slide-item
																																																																																																																																																																																						{{
																																																																																																																																																																																							routeCourante
																																																																																																																																																																																							== 'app_home'
																																																																																																																																																																																								? 'active'
																																																																																																																																																																																								: ''
																																																																																																																																																																																						}}
																																																																																																																																																																																					">

													<i class="fa fa-home mr-2"></i>

													Tableau de bord

												</a>

											</div>

										</div>

									</div>


									{# =================================================
																																																																																																																					   COMMERCIAL
																																																																																																																					   ================================================= #}

									{% if peutVoirCommercial %}

										<div data-panel="commercial" class="{{ menuActif == 'commercial' ? 'resp-tab-content-active' : '' }}">

											<div class="row">

												<div class="col-md-12">

													<h4 class="font-weight-normal">

														<i class="
																																																																																																																																																																																																				typcn
																																																																																																																																																																																																				typcn-shopping-cart
																																																																																																																																																																																																			"></i>

														Commercial

													</h4>


													{% if peutVoirClients %}

														<a href="{{ path('app_clients_index') }}" class="
																																																																																																																																																																																																																slide-item
																																																																																																																																																																																																																{{
																																																																																																																																																																																																																	routeCourante
																																																																																																																																																																																																																	starts with
																																																																																																																																																																																																																	'app_clients_'
																																																																																																																																																																																																																		? 'active'
																																																																																																																																																																																																																		: ''
																																																																																																																																																																																																																}}
																																																																																																																																																																																																															">

															<i class="fa fa-users mr-2"></i>

															Clients

														</a>

														{% if is_granted('ROLE_PAIEMENT_ENCAISSER') %}

															<a href="{{ path('app_clients_soldes') }}" class="
																																	slide-item
																																	{{
																																		routeCourante
																																		==
																																		'app_clients_soldes'
																																			? 'active'
																																			: ''
